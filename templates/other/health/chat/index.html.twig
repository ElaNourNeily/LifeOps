{% extends 'base.html.twig' %}

{% block title %}Assistant Santé AI - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto">
        <div class="mb-8">
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Assistant Santé AI</h1>
            <p class="text-muted-foreground">Posez vos questions sur votre sommeil, stress ou activité physique.</p>
        </div>

        <div class="rounded-xl border border-border bg-card shadow-lg p-6 mb-8">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-2xl">
                    🤖
                </div>
                <div>
                    <h2 class="text-xl font-semibold">Conseils Personnalisés</h2>
                    <p class="text-xs text-muted-foreground italic">Basé sur vos données des 7 derniers jours</p>
                </div>
            </div>

            <form method="post" class="space-y-4">
                <div>
                    <label for="question" class="block text-sm font-medium mb-2">Votre question :</label>
                    <textarea 
                        name="question" 
                        id="question" 
                        rows="4" 
                        class="w-full bg-background border border-input rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary transition-all shadow-sm"
                        placeholder="Ex: Comment puis-je améliorer ma qualité de sommeil ? ou 'Que penses-tu de mon activité physique cette semaine ?'"
                        required
                    ></textarea>
                </div>
                
                <button type="submit" class="w-full bg-primary text-primary-foreground font-semibold py-3 rounded-xl hover:bg-primary/90 transition-colors shadow-md flex items-center justify-center gap-2">
                    <span>🚀</span> Envoyer ma question
                </button>
            </form>
        </div>

        {% if response %}
            <div class="animate-in fade-in slide-in-from-bottom-4 duration-500">
                <div class="flex items-center gap-2 mb-4">
                    <h3 class="font-bold text-lg text-primary">Réponse de LifeOps AI</h3>
                </div>
                <div class="rounded-xl border border-border bg-secondary/30 p-6 shadow-sm">
                    <div class="prose prose-invert max-w-none text-foreground leading-relaxed whitespace-pre-wrap">
                        {{ response }}
                    </div>
                </div>
                
                <div class="mt-6 p-4 rounded-lg bg-yellow-500/10 border border-yellow-500/20 text-xs text-yellow-500/80 text-center">
                    ⚠️ Note : Cet assistant fournit des conseils de bien-être et ne remplace en aucun cas un avis médical professionnel.
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
