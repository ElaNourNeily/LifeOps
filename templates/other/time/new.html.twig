{% extends 'base.html.twig' %}

{% block title %}Créer un Planning - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        {# Header with back button #}
        <div class="flex items-center gap-6 mb-10">
            <a href="{{ path('app_planning_index') }}" class="flex items-center justify-center w-12 h-12 rounded-xl border border-border bg-secondary/50 text-foreground hover:bg-secondary transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </a>
            <div>
                <h1 class="text-4xl font-black tracking-tight text-foreground">Nouveau Planning</h1>
                <p class="text-muted-foreground font-medium mt-1">Configurez les paramètres de votre journée</p>
            </div>
        </div>

        <div class="rounded-2xl border border-border bg-card/40 backdrop-blur-sm text-card-foreground shadow-2xl overflow-hidden p-8 md:p-10 transition-all hover:bg-card/50">
            {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}
                
                {% if not form.vars.valid %}
                    <div class="p-4 rounded-xl bg-destructive/10 border border-destructive/20 text-destructive text-sm mb-6">
                        <div class="flex items-center gap-2 font-bold mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            Erreurs de validation
                        </div>
                        <ul class="list-disc list-inside space-y-1 ml-2">
                            {% for error in form.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                            {% for child in form.children %}{% if not child.vars.valid %}{% for error in child.vars.errors %}<li><strong>{{ (child.vars.label|default(child.vars.name)) }} :</strong> {{ error.message }}</li>{% endfor %}{% endif %}{% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# Main Info Card #}
                <div class="space-y-12">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Date cible</label>
                            <div class="relative group">
                                {{ form_widget(form.date, {'attr': {'class': 'flex h-14 w-full rounded-2xl border border-border bg-card/40 px-4 py-2 text-lg font-black focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 transition-all shadow-inner'}}) }}
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 pointer-events-none group-focus-within:text-primary transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                </div>
                            </div>
                            <div class="text-destructive text-xs font-bold mt-1">{{ form_errors(form.date) }}</div>
                        </div>

                        <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Disponibilité</label>
                            <div class="flex items-center justify-between h-14 w-full rounded-2xl bg-secondary/20 border border-border border-dashed px-6 transition-all hover:bg-secondary/30">
                                <span class="text-sm font-bold text-foreground">Générale</span>
                                {{ form_widget(form.disponibilite, {'attr': {'class': 'w-6 h-6 rounded-lg border-2 border-primary accent-primary cursor-pointer'}}) }}
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Début de journée</label>
                            <div class="relative group">
                                {{ form_widget(form.heure_debut_journee, {'attr': {'class': 'flex h-14 w-full rounded-2xl border border-border bg-card/40 px-4 py-2 text-lg font-black focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 transition-all shadow-inner'}}) }}
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 pointer-events-none group-focus-within:text-primary transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                </div>
                            </div>
                            <div class="text-destructive text-xs font-bold mt-1">{{ form_errors(form.heure_debut_journee) }}</div>
                        </div>
                         <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Fin de journée</label>
                            <div class="relative group">
                                {{ form_widget(form.heure_fin_journee, {'attr': {'class': 'flex h-14 w-full rounded-2xl border border-border bg-card/40 px-4 py-2 text-lg font-black focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 transition-all shadow-inner'}}) }}
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 pointer-events-none group-focus-within:text-primary transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                </div>
                            </div>
                            <div class="text-destructive text-xs font-bold mt-1">{{ form_errors(form.heure_fin_journee) }}</div>
                        </div>
                    </div>

                    {# Activities Section #}
                    <div class="space-y-6">
                        <div class="flex items-center justify-between pt-4 border-t border-border/30">
                            <h3 class="text-xs font-black uppercase tracking-[0.3em] text-primary">Activités Planifiées</h3>
                            <span class="text-[10px] font-medium text-muted-foreground/50 italic">Ajoutez des activités après création du planning</span>
                        </div>
                        <div class="py-10 border-2 border-dashed border-border/20 rounded-3xl text-center">
                            <div class="text-4xl mb-3">✦</div>
                            <p class="text-sm font-bold text-muted-foreground/40">Aucune activité — vous pourrez en ajouter depuis le calendrier.</p>
                        </div>
                    </div>
                </div>

                {# Actions #}
                <div class="pt-8 border-t border-border/50 flex flex-col gap-6">
                    <div class="flex flex-col md:flex-row justify-end items-center gap-6">
                        <div class="flex gap-4 w-full md:w-auto">
                            <a href="{{ path('app_planning_index') }}" class="flex h-14 flex-1 md:flex-none items-center justify-center rounded-xl text-md font-bold text-muted-foreground hover:text-foreground hover:bg-secondary transition-all px-8">
                                Annuler
                            </a>
                            <button type="submit" class="flex h-14 flex-1 md:flex-none items-center justify-center rounded-xl text-md font-black bg-primary text-white hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all px-12 shadow-xl shadow-primary/20">
                                Créer la journée
                            </button>
                        </div>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
