{% extends 'base.html.twig' %}

{% block title %}Paramètres de la Journée - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        {# Header with back button #}
        <div class="flex items-center gap-6 mb-10">
            <a href="{{ path('app_time_index', {'date': date|date('Y-m-d')}) }}" class="flex items-center justify-center w-12 h-12 rounded-xl border border-border bg-secondary/50 text-foreground hover:bg-secondary transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </a>
            <div>
                <h1 class="text-4xl font-black tracking-tight text-foreground">Paramètres du Jour</h1>
                <p class="text-muted-foreground font-medium mt-1">{{ date|date('d F Y') }}</p>
            </div>
        </div>

        <div class="rounded-2xl border border-border bg-card/40 backdrop-blur-sm text-card-foreground shadow-2xl overflow-hidden p-8 md:p-10 transition-all hover:bg-card/50">
            {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}
                
                {% if not form.vars.valid %}
                    <div class="p-4 rounded-xl bg-destructive/10 border border-destructive/20 text-destructive text-sm mb-6">
                        <div class="flex items-center gap-2 font-bold mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            Erreurs de validation
                        </div>
                        <ul class="list-disc list-inside space-y-1 ml-2">
                            {% for error in form.vars.errors %}<li>{{ error.message }}</li>{% endfor %}
                            {% for child in form.children %}{% if not child.vars.valid %}{% for error in child.vars.errors %}<li><strong>{{ (child.vars.label|default(child.vars.name)) }} :</strong> {{ error.message }}</li>{% endfor %}{% endif %}{% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# Main Info Card #}
                <div class="space-y-12">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Date de la journée</label>
                            <div class="flex h-14 w-full rounded-2xl border border-border bg-secondary/20 px-4 py-2 text-lg font-black text-muted-foreground/40 shadow-inner flex items-center gap-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                {{ date|date('d/m/Y') }}
                            </div>
                            <div class="hidden">{{ form_widget(form.date) }}</div>
                        </div>

                        <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Disponibilité</label>
                            <div class="flex items-center justify-between h-14 w-full rounded-2xl bg-secondary/20 border border-border border-dashed px-6 transition-all hover:bg-secondary/30">
                                <span class="text-sm font-bold text-foreground">Générale</span>
                                {{ form_widget(form.disponibilite, {'attr': {'class': 'w-6 h-6 rounded-lg border-2 border-primary accent-primary cursor-pointer'}}) }}
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Début de journée</label>
                            <div class="relative group">
                                {{ form_widget(form.heure_debut_journee, {'attr': {'class': 'flex h-14 w-full rounded-2xl border border-border bg-card/40 px-4 py-2 text-lg font-black focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 transition-all shadow-inner'}}) }}
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 pointer-events-none group-focus-within:text-primary transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                </div>
                            </div>
                            <div class="text-destructive text-xs font-bold mt-1">{{ form_errors(form.heure_debut_journee) }}</div>
                        </div>
                         <div class="space-y-3">
                            <label class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground/60">Fin de journée</label>
                            <div class="relative group">
                                {{ form_widget(form.heure_fin_journee, {'attr': {'class': 'flex h-14 w-full rounded-2xl border border-border bg-card/40 px-4 py-2 text-lg font-black focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20 transition-all shadow-inner'}}) }}
                                <div class="absolute right-4 top-1/2 -translate-y-1/2 text-muted-foreground/40 pointer-events-none group-focus-within:text-primary transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                </div>
                            </div>
                            <div class="text-destructive text-xs font-bold mt-1">{{ form_errors(form.heure_fin_journee) }}</div>
                        </div>
                    </div>

                    {# Activities Section #}
                    <div class="space-y-6">
                        <div class="flex items-center justify-between pt-6">
                            <h3 class="text-xs font-black uppercase tracking-[0.3em] text-primary">Activités Planifiées ({{ form.activites|length }})</h3>
                            <a href="{{ path('app_activite_new', {date: date|date('Y-m-d')}) }}" class="text-[10px] font-black uppercase tracking-widest text-muted-foreground hover:text-primary transition-all">
                                + Nouvelle activité
                            </a>
                        </div>
                        
                        <div class="space-y-4">
                            {% for activiteForm in form.activites %}
                                <div class="group relative p-8 rounded-3xl border border-border bg-secondary/10 hover:bg-secondary/20 transition-all">
                                    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                                        {# Basic Info #}
                                        <div class="md:col-span-4 space-y-4">
                                            <div class="space-y-2">
                                                <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/50">Titre</label>
                                                {{ form_widget(activiteForm.titre, {'attr': {'class': 'flex h-10 w-full rounded-xl border-none bg-card/50 px-3 text-sm font-bold focus:ring-2 focus:ring-primary/30 transition-all placeholder:text-muted-foreground/30'}}) }}
                                            </div>
                                            <div class="grid grid-cols-2 gap-4">
                                                <div class="space-y-2">
                                                    <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/50">Début</label>
                                                    {{ form_widget(activiteForm.heure_debut_estimee, {'attr': {'class': 'flex h-10 w-full rounded-xl border-none bg-card/50 px-3 text-sm font-bold focus:ring-2 focus:ring-primary/30'}}) }}
                                                </div>
                                                <div class="space-y-2">
                                                    <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/50">Fin</label>
                                                    {{ form_widget(activiteForm.heure_fin_estimee, {'attr': {'class': 'flex h-10 w-full rounded-xl border-none bg-card/50 px-3 text-sm font-bold focus:ring-2 focus:ring-primary/30'}}) }}
                                                </div>
                                            </div>
                                        </div>

                                        {# Meta Data #}
                                        <div class="md:col-span-4 space-y-4">
                                            <div class="space-y-2">
                                                <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/50">Catégorie</label>
                                                {{ form_widget(activiteForm.categorie, {'attr': {'class': 'flex h-10 w-full rounded-xl border-none bg-card/50 px-3 text-sm font-bold focus:ring-2 focus:ring-primary/30'}}) }}
                                            </div>
                                             <div class="space-y-2">
                                                <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/50">Priorité & Urgence</label>
                                                <div class="grid grid-cols-2 gap-2">
                                                    {{ form_widget(activiteForm.priorite, {'attr': {'class': 'flex h-10 w-full rounded-xl border-none bg-card/50 px-3 text-xs font-bold focus:ring-2 focus:ring-primary/30'}}) }}
                                                    {{ form_widget(activiteForm.niveau_urgence, {'attr': {'class': 'flex h-10 w-full rounded-xl border-none bg-card/50 px-3 text-xs font-bold focus:ring-2 focus:ring-primary/30'}}) }}
                                                </div>
                                            </div>
                                        </div>

                                        {# Status & Color #}
                                        <div class="md:col-span-4 space-y-4">
                                            <div class="space-y-2">
                                                <label class="text-[9px] font-black uppercase tracking-widest text-muted-foreground/50">Thème Visuel</label>
                                                <div class="flex flex-wrap gap-2 p-1.5 rounded-xl bg-card/30">
                                                    {% for child in activiteForm.couleur %}
                                                        <label class="relative cursor-pointer group/color">
                                                            <input type="radio" value="{{ child.vars.value }}" name="{{ child.vars.full_name }}" class="peer sr-only" {{ child.vars.checked ? 'checked' : '' }}>
                                                            <div class="w-6 h-6 rounded-lg transition-all peer-checked:ring-4 peer-checked:ring-white/20 peer-checked:scale-110 shadow-sm" style="background-color: {{ child.vars.value }}"></div>
                                                            <div class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 rounded bg-black text-[8px] font-black text-white opacity-0 group-hover/color:opacity-100 transition-opacity pointer-events-none whitespace-nowrap uppercase tracking-tighter">
                                                                {{ child.vars.label }}
                                                            </div>
                                                        </label>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    {# Delete Action #}
                                    {% if activiteForm.vars.data is not null and activiteForm.vars.data.id %}
                                        <form method="post" action="{{ path('app_activite_delete', {id: activiteForm.vars.data.id}) }}"
                                              class="absolute top-4 right-4"
                                              onsubmit="return confirm('Supprimer cette activité ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activiteForm.vars.data.id) }}">
                                            <button type="submit"
                                                    class="w-8 h-8 rounded-lg bg-destructive/5 hover:bg-destructive/20 text-destructive/50 hover:text-destructive flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 shadow-sm"
                                                    title="Supprimer cette activité">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                    <div class="hidden">{{ form_rest(activiteForm) }}</div>
                                </div>
                            {% else %}
                                <div class="py-12 border-2 border-dashed border-border/30 rounded-3xl text-center">
                                    <p class="text-sm font-bold text-muted-foreground/40 italic">Aucune activité pour ce jour</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# Actions #}
                <div class="pt-8 border-t border-border/50 flex flex-col gap-6">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                        {% if planning.id %}
                            <button type="button" 
                                    onclick="if(confirm('Cela supprimera toutes vos activités pour ce jour. Continuer ?')) document.getElementById('form-delete-planning').submit();"
                                    class="text-destructive font-bold text-sm hover:underline transition-all">
                                Réinitialiser (Supprimer le planning)
                            </button>
                        {% else %}
                            <div></div>
                        {% endif %}
                        
                        <div class="flex gap-4 w-full md:w-auto">
                            <a href="{{ path('app_time_index', {'date': date|date('Y-m-d')}) }}" class="flex h-14 flex-1 md:flex-none items-center justify-center rounded-xl text-md font-bold text-muted-foreground hover:text-foreground hover:bg-secondary transition-all px-8">
                                Annuler
                            </a>
                            <button type="submit" class="flex h-14 flex-1 md:flex-none items-center justify-center rounded-xl text-md font-black bg-primary text-white hover:bg-primary/90 hover:scale-[1.02] active:scale-[0.98] transition-all px-12 shadow-xl shadow-primary/20">
                                Enregistrer
                            </button>
                        </div>
                    </div>
                </div>
            {{ form_end(form) }}

            {% if planning.id %}
                <form id="form-delete-planning" method="post" action="{{ path('app_planning_delete', {'id': planning.id}) }}" class="hidden">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ planning.id) }}">
                </form>
            {% endif %}
        </div>

        {# Info Footer #}
        <div class="mt-10 p-6 rounded-2xl bg-primary/5 border border-primary/10 text-muted-foreground text-sm backdrop-blur-sm">
            <div class="flex gap-4">
                <div class="p-2 rounded-lg bg-primary/10 text-primary shrink-0 h-fit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                </div>
                <p class="leading-relaxed">
                    Ces horaires définissent la plage visible dans votre calendrier. Les activités en dehors de ces heures seront toujours conservées mais pourraient être masquées selon votre vue.
                </p>
            </div>
        </div>
    </div>
{% endblock %}

