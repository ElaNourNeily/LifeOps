{% extends 'base.html.twig' %}

{% block title %}Calendrier - LifeOps{% endblock %}

{% block body %}
<div class="flex flex-col gap-10">
    {# Header with Controls #}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-black uppercase tracking-[0.2em]">Tableau de bord</span>
            </div>
            <h1 class="text-4xl font-black tracking-tight text-foreground">{{ formattedDateTitle }}</h1>
            <p class="text-muted-foreground font-medium mt-1">Gérez votre temps avec précision et élégance.</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-4">
            <div class="flex items-center rounded-2xl border border-border bg-card/40 backdrop-blur-sm p-1.5 shadow-xl">
                <a href="{{ path('app_time_index', {view: 'day', date: currentDate|date('Y-m-d')}) }}" 
                   class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all {{ view == 'day' ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-muted-foreground hover:text-foreground hover:bg-secondary/50' }}">
                    Jour
                </a>
                <a href="{{ path('app_time_index', {view: 'week', date: currentDate|date('Y-m-d')}) }}" 
                   class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all {{ view == 'week' ? 'bg-primary text-white shadow-lg shadow-primary/20' : 'text-muted-foreground hover:text-foreground hover:bg-secondary/50' }}">
                    Semaine
                </a>
            </div>

            <div class="flex items-center gap-2 p-1.5 rounded-2xl border border-border bg-card/40 backdrop-blur-sm shadow-xl">
                <a href="{{ path('app_time_index', {view: view, date: currentDate|date_modify('-1 ' ~ (view == 'week' ? 'week' : 'day'))|date('Y-m-d')}) }}" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl bg-secondary/50 hover:bg-secondary text-foreground transition-all shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </a>
                <a href="{{ path('app_time_index', {view: view, date: 'now'|date('Y-m-d')}) }}" 
                   class="px-4 py-2 rounded-xl bg-secondary/30 hover:bg-secondary/50 text-xs font-black uppercase tracking-widest transition-all">
                    Aujourd'hui
                </a>
                <a href="{{ path('app_time_index', {view: view, date: currentDate|date_modify('+1 ' ~ (view == 'week' ? 'week' : 'day'))|date('Y-m-d')}) }}" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl bg-secondary/50 hover:bg-secondary text-foreground transition-all shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            </div>

            <div class="flex items-center gap-3">
                <a href="{{ path('app_planning_new') }}" class="inline-flex items-center gap-2 px-6 h-14 rounded-2xl bg-primary text-white hover:bg-primary/90 font-black text-sm transition-all shadow-2xl shadow-primary/30 hover:scale-[1.02] active:scale-[0.98]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    Nouveau Planning
                </a>
                
                <a href="{{ path('app_time_export', {date: currentDate|date('Y-m-d')}) }}" class="w-14 h-14 flex items-center justify-center rounded-2xl border border-border bg-card/40 backdrop-blur-sm text-foreground hover:bg-secondary shadow-xl transition-all" title="Exporter en PDF">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </a>
            </div>
        </div>
    </div>

    {# Calendar Grid Container #}
    <div class="rounded-[2.5rem] border border-border bg-card/40 backdrop-blur-md shadow-2xl overflow-hidden overflow-x-auto transition-all hover:bg-card/50">
        <div class="min-w-[1000px]">
            {# Grid Header #}
            <div class="grid {{ view == 'week' ? 'grid-cols-8' : 'grid-cols-2' }} border-b border-border/50 bg-secondary/10">
                <div class="p-6 border-r border-border/50 text-[10px] font-black text-muted-foreground/60 uppercase tracking-[0.2em] text-center flex items-center justify-center">
                    Track
                </div>
                {% for day in weekDays %}
                    <div class="p-6 {{ not loop.last ? 'border-r border-border/50' : '' }} text-center">
                        <span class="block text-[10px] font-black text-muted-foreground/40 uppercase tracking-[0.2em] mb-1">{{ day|date('D') }}</span>
                        <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl text-xl font-black {{ day|date('Y-m-d') == 'now'|date('Y-m-d') ? 'bg-primary text-white shadow-lg shadow-primary/20 scale-110' : 'text-foreground hover:bg-secondary/40 transition-all' }}">{{ day|date('d') }}</span>
                    </div>
                {% endfor %}
            </div>

            {# Grid Body #}
            <div class="relative">
                {# Hour Rows #}
                {% for hour in gridStart..gridEnd %}
                    <div class="grid {{ view == 'week' ? 'grid-cols-8' : 'grid-cols-2' }} border-b border-border/30 min-h-[100px]">
                        <div class="p-4 border-r border-border/30 text-[10px] font-black text-muted-foreground/30 text-center bg-muted/5 flex items-start justify-center pt-6">
                            {{ "%02d"|format(hour) }}:00
                        </div>
                        {% for day in weekDays %}
                            {% set dateKey = day|date('Y-m-d') %}
                            <div class="relative p-1.5 {{ not loop.last ? 'border-r border-border/30' : '' }} group transition-all">
                                {# Activities for this hour/day #}
                                {% if activitiesByDay[dateKey] is defined %}
                                    {% for activity in activitiesByDay[dateKey] %}
                                        {# Show activity if it starts in this hour #}
                                        {% if activity.heureDebutEstimee|date('H') == hour %}
                                            {% set startMin = activity.heureDebutEstimee|date('i') %}
                                            {% set durationMin = (activity.heureFinEstimee.timestamp - activity.heureDebutEstimee.timestamp) / 60 %}
                                            {% set topOffset = (startMin / 60) * 100 %}
                                            {% set height = (durationMin / 60) * 100 %} {# 100px is base hour height #}
                                            
                                            <div class="absolute inset-x-2 z-10 rounded-2xl p-4 shadow-xl border border-white/5 hover:border-white/20 transition-all cursor-pointer overflow-hidden group/item hover:scale-[1.01] hover:z-20 active:scale-[0.99]"
                                                 style="top: {{ topOffset }}%; height: {{ height }}px; background-color: {{ activity.couleur|default('#4f46e5') }}; color: white;"
                                                 title="{{ activity.titre }} ({{ activity.statutDynamique }})"
                                                 onclick="window.location.href='{{ path('app_activite_edit', {id: activity.id}) }}'">
                                                <div class="flex items-start justify-between gap-2 overflow-hidden mb-1">
                                                    <span class="text-xs font-black uppercase tracking-tight truncate">{{ activity.titre }}</span>
                                                    <span class="text-[10px] font-bold opacity-70 shrink-0 bg-black/20 px-1.5 py-0.5 rounded-lg">{{ activity.heureDebutEstimee|date('H:i') }}</span>
                                                </div>
                                                <div class="text-[9px] font-bold opacity-60 uppercase tracking-widest line-clamp-1">
                                                    {{ activity.categorie }} • {{ activity.priorite|capitalize }}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                                
                                {# Quick Add Link #}
                                <a href="{{ path('app_activite_new', {date: dateKey, start: hour}) }}" 
                                   class="absolute inset-0 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-all">
                                    <div class="p-2 rounded-xl bg-primary/20 text-primary scale-90 group-hover:scale-100 transition-all font-black text-[10px] uppercase tracking-widest">
                                        + Planifier
                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# Bottom Insights Section #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        <div class="p-8 rounded-[2.5rem] border border-border/50 bg-card/30 backdrop-blur-sm shadow-xl transition-all hover:bg-card/40">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="m3 3 3 8 2 2 8-8 3 3-5 5-2 2-3-3"/><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"/></svg>
                </div>
                <h3 class="font-black text-xs uppercase tracking-[0.2em] text-foreground">Objectifs</h3>
            </div>
            <div class="space-y-4">
                <div class="flex items-center justify-between text-xs font-bold text-muted-foreground uppercase tracking-widest">
                    <span>Progression</span>
                    <span class="text-primary font-black">78%</span>
                </div>
                <div class="h-1.5 w-full bg-secondary/50 rounded-full overflow-hidden">
                    <div class="h-full bg-primary rounded-full transition-all duration-1000" style="width: 78%"></div>
                </div>
                <p class="text-[11px] font-medium text-muted-foreground leading-relaxed">
                    Vous êtes en avance sur votre planning hebdomadaire. Continuez ainsi !
                </p>
            </div>
        </div>

        <div class="col-span-1 md:col-span-2 p-8 rounded-[2.5rem] border border-border/50 bg-card/30 backdrop-blur-sm shadow-xl transition-all hover:bg-card/40">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 rounded-xl bg-primary/10 text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"/><path d="M7 16V4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v12"/><path d="M5 20h14"/><path d="M7 16H5a2 2 0 0 0-2 2v2"/><path d="M17 16h2a2 2 0 0 1 2 2v2"/></svg>
                    </div>
                    <h3 class="font-black text-xs uppercase tracking-[0.2em] text-foreground">Indicateurs de Performance</h3>
                </div>
                <a href="{{ path('app_planning_index') }}" class="text-[10px] font-black text-primary uppercase tracking-widest hover:underline p-2 rounded-lg hover:bg-primary/5">Tout voir</a>
            </div>
            
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="p-5 rounded-2xl bg-secondary/10 border border-border/30 transition-all hover:border-primary/20">
                    <p class="text-[9px] text-muted-foreground uppercase font-black tracking-[0.2em] mb-2">Activités</p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-3xl font-black text-foreground">{% set total = 0 %}{% for activities in activitiesByDay %}{% set total = total + activities|length %}{% endfor %}{{ total }}</span>
                        <span class="text-[10px] font-bold text-emerald-500">+12%</span>
                    </div>
                </div>
                <div class="p-5 rounded-2xl bg-secondary/10 border border-border/30 transition-all hover:border-primary/20">
                    <p class="text-[9px] text-muted-foreground uppercase font-black tracking-[0.2em] mb-2">Moyenne</p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-3xl font-black text-foreground">{{ (total / weekDays|length)|number_format(1) }}</span>
                        <span class="text-[10px] font-bold text-muted-foreground/40">/jour</span>
                    </div>
                </div>
                <div class="p-5 rounded-2xl bg-secondary/10 border border-border/30 transition-all hover:border-primary/20">
                    <p class="text-[9px] text-muted-foreground uppercase font-black tracking-[0.2em] mb-2">Focus Time</p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-3xl font-black text-foreground">18h</span>
                        <span class="text-[10px] font-bold text-emerald-500">+4h</span>
                    </div>
                </div>
                <div class="p-5 rounded-2xl bg-secondary/10 border border-border/30 transition-all hover:border-primary/20">
                    <p class="text-[9px] text-muted-foreground uppercase font-black tracking-[0.2em] mb-2">Dispo</p>
                    <div class="flex items-baseline gap-2">
                        <span class="text-3xl font-black text-foreground">42%</span>
                        <span class="text-[10px] font-bold text-pink-500">-5%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
{% endblock %}
