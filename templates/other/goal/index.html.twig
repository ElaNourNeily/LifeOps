{% extends 'base.html.twig' %}

{% block title %}Objectifs - LifeOps{% endblock %}

{% block body %}
    <script>
        async function analyzeSmart(btn, url, resultId) {
            const container = document.getElementById(resultId);
            const originalContent = btn.innerHTML;
            
            btn.disabled = true;
            btn.innerHTML = '<svg class="animate-spin h-4 w-4 mr-2" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Analyse en cours...';
            
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                
                if (!response.ok) throw new Error('Erreur réseau');
                
                const data = await response.json();
                
                container.classList.remove('hidden');
                container.innerHTML = `
                    <div class="flex flex-col gap-4">
                        <div class="grid grid-cols-5 gap-2">
                            ${Object.entries(data.scores).map(([letter, score]) => `
                                <div class="flex flex-col items-center gap-1">
                                    <span class="text-[10px] font-bold text-muted-foreground uppercase">${letter}</span>
                                    <div class="w-full h-1.5 bg-secondary rounded-full overflow-hidden">
                                        <div class="h-full bg-primary" style="width: ${score * 10}%"></div>
                                    </div>
                                    <span class="text-[10px] font-medium text-primary">${score}/10</span>
                                </div>
                            `).join('')}
                        </div>
                        <div class="text-xs text-foreground/90 leading-relaxed italic border-l-2 border-primary/30 pl-3">
                            ${data.advice}
                        </div>
                    </div>
                `;
            } catch (error) {
                console.error(error);
                container.classList.remove('hidden');
                container.innerHTML = '<p class="text-xs text-destructive">Erreur lors de l\'analyse. Réessayez plus tard.</p>';
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
        }
    </script>
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Mes Objectifs</h1>
            <p class="text-muted-foreground mt-1">Gérez vos ambitions et suivez votre progression.</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('app_goal_export_vision_board') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-card hover:bg-muted text-foreground/80 h-10 px-4 py-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Vision Board (PDF)
            </a>
            <button class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border bg-card hover:bg-muted text-muted-foreground transition-colors mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </button>
            <a href="{{ path('app_goal_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nouvel objectif
            </a>
        </div>
    </div>

    {% if recommendations %}
        <div class="mb-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for rec in recommendations %}
                <div class="p-4 rounded-xl border border-primary/20 bg-secondary/30 flex flex-col justify-between group hover:border-primary/40 transition-all shadow-sm">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                            <h5 class="text-xs font-bold uppercase tracking-widest text-primary">{{ rec.title }}</h5>
                        </div>
                        <p class="text-xs text-muted-foreground leading-relaxed">{{ rec.description }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if quote %}
        <div class="mb-8 p-6 rounded-2xl bg-gradient-to-br from-primary/10 via-background to-secondary/10 border border-primary/10 shadow-sm relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 opacity-[0.03] group-hover:opacity-[0.05] transition-opacity duration-500">
                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1 0 2.5 0 5-2 7Zm12 0c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1 0 2.5 0 5-2 7Z"/></svg>
            </div>
            <div class="relative z-10">
                <p class="text-lg md:text-xl font-medium italic text-foreground/90 leading-relaxed mb-3">
                    "{{ quote.text }}"
                </p>
                <div class="flex items-center gap-2">
                    <div class="h-px w-8 bg-primary/30"></div>
                    <span class="text-sm font-semibold text-primary/80 tracking-wide uppercase">{{ quote.author }}</span>
                </div>
            </div>
        </div>
    {% endif %}

    <form method="GET" action="{{ path('app_goal_index') }}" class="flex flex-col md:flex-row gap-4 items-center justify-between mb-8">
        <div class="relative w-full md:w-[400px]">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" name="q" value="{{ current_query }}" placeholder="Rechercher un objectif..." class="flex h-10 w-full rounded-full border border-input bg-card/50 px-3 py-2 pl-10 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring focus-visible:ring-offset-1 disabled:cursor-not-allowed disabled:opacity-50">
        </div>
        <div class="flex items-center justify-between w-full md:w-auto gap-4">
            <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 overflow-hidden hide-scrollbar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground mr-1 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                <input type="hidden" name="categorie" value="{{ current_category }}">
                
                {% set categories = {'all': 'Tous', 'personal': 'Personnel', 'professional': 'Professionnel', 'health': 'Santé', 'finance': 'Finance'} %}
                
                {% for code, label in categories %}
                    <button type="submit" name="categorie" value="{{ code }}" class="inline-flex items-center justify-center rounded-full text-xs font-medium transition-colors {{ current_category == code ? 'bg-primary text-primary-foreground hover:bg-primary/90' : 'bg-secondary text-secondary-foreground hover:bg-secondary/80' }} h-7 px-3 shrink-0">
                        {{ label }}
                    </button>
                {% endfor %}
            </div>
            
            <div class="shrink-0 flex items-center gap-2">
                <select name="sort" onchange="this.form.submit()" class="h-8 rounded-md border border-input bg-card px-2 py-1 text-xs ring-offset-background focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring focus-visible:ring-offset-1">
                    <option value="date_fin_asc" {% if current_sort == 'date_fin_asc' %}selected{% endif %}>⏳ Proche échéance</option>
                    <option value="date_fin_desc" {% if current_sort == 'date_fin_desc' %}selected{% endif %}>📅 Échéance lointaine</option>
                    <option value="progression_desc" {% if current_sort == 'progression_desc' %}selected{% endif %}>📈 Plus avancés</option>
                    <option value="progression_asc" {% if current_sort == 'progression_asc' %}selected{% endif %}>📉 Moins avancés</option>
                </select>
                <noscript>
                    <button type="submit" class="h-8 px-2 rounded-md bg-primary text-primary-foreground text-xs">Trier</button>
                </noscript>
            </div>
        </div>
    </form>

    <!-- Goals List -->
    <div class="mb-4">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">
            {% if current_query or current_category != 'all' %}
                Résultats ({{ objectifs.getTotalItemCount }})
            {% else %}
                En cours ({{ objectifs.getTotalItemCount }})
            {% endif %}
        </h2>
        <div class="space-y-4">
            {% for objectif in objectifs %}
                <details class="group rounded-xl border border-border bg-card text-card-foreground shadow overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="p-4 flex items-center justify-between gap-4 cursor-pointer hover:bg-muted/30 transition-colors list-none">
                        <div class="flex items-center gap-4 flex-1 overflow-hidden">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
                            
                            <span class="inline-flex items-center justify-center rounded-full border px-2.5 py-0.5 text-xs font-medium border-transparent bg-secondary text-secondary-foreground shrink-0 min-w-16">
                                {{ objectif.categorie|capitalize }}
                            </span>
                            
                            <span class="font-medium text-sm truncate max-w-[200px] sm:max-w-xs">{{ objectif.titre }}</span>
                            
                            <div class="hidden md:flex flex-1 items-center gap-3 ml-4 max-w-sm">
                                <div class="h-1.5 w-full rounded-full bg-secondary overflow-hidden">
                                    <div class="h-full rounded-full bg-primary transition-all duration-500" style="width: {{ objectif.progression }}%"></div>
                                </div>
                                <span class="text-xs font-medium text-primary w-8 text-right">{{ objectif.progression }}%</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-1 shrink-0">
                            <form method="post" action="{{ path('app_goal_toggle', {'id': objectif.id}) }}" class="m-0 p-0" onsubmit="event.stopPropagation();">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ objectif.id) }}">
                                <button type="submit" title="{{ objectif.statut == 'achieved' ? 'Marquer comme en cours' : 'Marquer comme terminé' }}" class="inline-flex items-center justify-center rounded-md h-8 w-8 transition-colors hover:bg-muted {{ objectif.statut == 'achieved' ? 'text-primary bg-primary/10 hover:bg-primary/20' : 'text-muted-foreground hover:text-primary' }}" onclick="event.stopPropagation();">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                                </button>
                            </form>
                            <a href="{{ path('app_goal_edit', {'id': objectif.id}) }}" title="Modifier" class="inline-flex items-center justify-center rounded-md h-8 w-8 text-muted-foreground hover:text-primary transition-colors hover:bg-muted" onclick="event.stopPropagation();">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                            </a>
                            <form method="post" action="{{ path('app_goal_delete', {'id': objectif.id}) }}" class="m-0 p-0" onsubmit="event.stopPropagation();" data-confirm="Voulez-vous vraiment supprimer cet objectif et toutes ses étapes ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ objectif.id) }}">
                                <button type="submit" title="Supprimer" class="inline-flex items-center justify-center rounded-md h-8 w-8 text-muted-foreground hover:text-destructive transition-colors hover:bg-muted" onclick="event.stopPropagation();">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                </button>
                            </form>
                        </div>
                    </summary>

                    <!-- Expanded Details -->
                    <div class="border-t border-border bg-card/30">
                        <div class="p-6 md:px-14 space-y-8">
                            

                            
                            <p class="text-sm text-foreground/80 leading-relaxed max-w-3xl">{{ objectif.description }}</p>
                            
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div class="rounded-lg border border-border/50 bg-card p-3 shadow-sm">
                                    <span class="text-xs text-muted-foreground block mb-1">Début</span>
                                    <span class="font-medium text-sm">{{ objectif.dateDebut ? objectif.dateDebut|date('Y-m-d') : '-' }}</span>
                                </div>
                                <div class="rounded-lg border border-border/50 bg-card p-3 shadow-sm">
                                    <span class="text-xs text-muted-foreground block mb-1">Fin</span>
                                    <span class="font-medium text-sm">{{ objectif.dateFin ? objectif.dateFin|date('Y-m-d') : '-' }}</span>
                                </div>
                                <div class="rounded-lg border border-border/50 bg-card p-3 shadow-sm">
                                    <span class="text-xs text-muted-foreground block mb-1">Statut</span>
                                    <span class="font-medium text-sm text-accent-foreground">{{ objectif.statut|capitalize }}</span>
                                </div>
                                <div class="rounded-lg border border-border/50 bg-card p-3 shadow-sm">
                                    <span class="text-xs text-muted-foreground block mb-1">Jours restants</span>
                                    {% set days_remaining = 0 %}
                                    {% if objectif.dateFin and objectif.dateFin > date() %}
                                        {% set days_remaining = (objectif.dateFin.timestamp - date().timestamp) // (24 * 3600) %}
                                    {% endif %}
                                    <span class="font-medium text-sm">{{ days_remaining > 0 ? days_remaining : '-' }}</span>
                                </div>
                            </div>

                            <div class="space-y-4 max-w-3xl">
                                <div class="flex items-center justify-between text-sm">
                                    <h4 class="font-medium text-foreground">Progression vs Temps</h4>
                                    {% set time_progress = 0 %}
                                    {% if objectif.dateDebut and objectif.dateFin %}
                                        {% set total_days = (objectif.dateFin.timestamp - objectif.dateDebut.timestamp) // (24 * 3600) %}
                                        {% set passed_days = (date().timestamp - objectif.dateDebut.timestamp) // (24 * 3600) %}
                                        {% if passed_days > 0 and total_days > 0 %}
                                            {% set time_progress = (passed_days / total_days * 100)|round %}
                                            {% set time_progress = time_progress > 100 ? 100 : time_progress %}
                                        {% endif %}
                                    {% endif %}
                                    {% if objectif.progression >= time_progress %}
                                        <span class="text-xs text-primary font-medium">En avance</span>
                                    {% else %}
                                        <span class="text-xs text-destructive font-medium">En retard</span>
                                    {% endif %}
                                </div>
                                
                                <div class="space-y-3">
                                    <div class="flex items-center gap-4 text-xs">
                                        <span class="text-muted-foreground w-16">Objectif</span>
                                        <div class="flex-1 h-3 rounded-full bg-secondary overflow-hidden">
                                            <div class="h-full rounded-full bg-primary transition-all duration-500" style="width: {{ objectif.progression }}%"></div>
                                        </div>
                                        <span class="font-medium w-8 text-right text-foreground">{{ objectif.progression }}%</span>
                                    </div>
                                    <div class="flex items-center gap-4 text-xs">
                                        <span class="text-muted-foreground w-16">Temps</span>
                                        <div class="flex-1 h-3 rounded-full bg-secondary overflow-hidden">
                                            <div class="h-full rounded-full bg-foreground/30 transition-all duration-500" style="width: {{ time_progress }}%"></div>
                                        </div>
                                        <span class="font-medium w-8 text-right text-foreground">{{ time_progress }}%</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Plan d'action -->
                            <div class="pt-4 max-w-3xl">
                                {% set plan_actions = objectif.planActions %}
                                {% set completed_actions = 0 %}
                                {% if plan_actions %}
                                    {% for action in plan_actions %}
                                        {% if action.statut == 'done' %}{% set completed_actions = completed_actions + 1 %}{% endif %}
                                    {% endfor %}
                                {% endif %}
                                <h4 class="font-medium text-foreground text-sm mb-4">Plan d'action ({{ plan_actions ? completed_actions ~ '/' ~ plan_actions|length : '0/0' }})</h4>
                                
                                <div class="space-y-4">
                                    {% if plan_actions and plan_actions|length > 0 %}
                                        <ul class="space-y-3">
                                            {% for action in plan_actions %}
                                                <li class="flex items-center justify-between gap-3 text-sm group/item mb-1 relative hover:bg-muted/20 p-1.5 -mx-1.5 rounded-md transition-colors">
                                                    <div class="flex items-start gap-3 w-full pr-16 text-foreground/90 {{ action.statut == 'done' ? 'line-through text-muted-foreground' : '' }}">
                                                        <form method="post" action="{{ path('app_goal_action_toggle', {'id': action.id}) }}" class="m-0 p-0">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ action.id) }}">
                                                            <button type="submit" title="{{ action.statut == 'done' ? 'Marquer comme à faire' : 'Marquer comme terminé' }}" class="mt-0.5 h-4 w-4 rounded-full border flex items-center justify-center shrink-0 transition-colors {{ action.statut == 'done' ? 'bg-primary/20 border-primary text-primary' : 'border-muted-foreground hover:bg-muted-foreground/10 text-transparent hover:text-muted-foreground/50' }}">
                                                                {% if action.statut == 'done' %}
                                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                                                {% else %}
                                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                                                                {% endif %}
                                                            </button>
                                                        </form>
                                                        <div class="flex flex-col">
                                                            <span class="">{{ action.titre }}</span>
                                                            {% if action.description %}
                                                                <span class="text-xs text-muted-foreground mt-0.5 max-w-prose line-clamp-2">{{ action.description }}</span>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="absolute right-1.5 top-1/2 -translate-y-1/2 flex items-center opacity-0 group-hover/item:opacity-100 transition-opacity">
                                                        <a href="{{ path('app_goal_action_edit', {'id': action.id}) }}" class="p-1.5 text-muted-foreground hover:text-primary transition-colors focus:opacity-100" title="Modifier">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                                        </a>
                                                        <form method="post" action="{{ path('app_goal_action_delete', {'id': action.id}) }}" class="inline-block" data-confirm="Êtes-vous sûr de vouloir supprimer cette étape ?">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ action.id) }}">
                                                            <button type="submit" class="p-1.5 text-muted-foreground hover:text-destructive transition-colors focus:opacity-100" title="Supprimer">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        <form method="post" action="{{ path('app_goal_ai_suggest', {'id': objectif.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('ai_suggest' ~ objectif.id) }}">
                                            <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 h-9 px-4 py-2 w-full sm:w-auto">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
                                                Générer avec l'IA
                                            </button>
                                        </form>
                                        <button type="button" 
                                                onclick="analyzeSmart(this, '{{ path('app_goal_analyze_smart', {'id': objectif.id}) }}', 'smart-analysis-{{ objectif.id }}')"
                                                class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-secondary/50 text-secondary-foreground border border-secondary/80 hover:bg-secondary h-9 px-4 py-2 w-full sm:w-auto">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="M12 20h.01"/><path d="M7 20h.01"/><path d="M17 20h.01"/><path d="M12 16h.01"/><path d="M7 16h.01"/><path d="M17 16h.01"/><path d="M12 12h.01"/><path d="M7 12h.01"/><path d="M17 12h.01"/><path d="M12 8h.01"/><path d="M7 8h.01"/><path d="M17 8h.01"/><path d="M12 4h.01"/><path d="M7 4h.01"/><path d="M17 4h.01"/></svg>
                                            Analyser (SMART)
                                        </button>
                                        
                                        <div id="smart-analysis-{{ objectif.id }}" class="hidden w-full mt-4 p-4 rounded-xl border border-primary/20 bg-primary/5 space-y-4 animate-in fade-in slide-in-from-top-2">
                                            <!-- Results will be injected here -->
                                        </div>
                                        
                                        <a href="{{ path('app_goal_action_new', {'id': objectif.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-border bg-card hover:bg-muted text-foreground/80 h-9 px-4 py-2 w-full sm:w-auto">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                            Ajouter une étape
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </details>
            {% else %}
                <div class="rounded-xl border border-dashed border-border bg-card/50 p-12 text-center">
                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-secondary mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-muted-foreground"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    </div>
                    <h3 class="text-lg font-medium text-foreground">Aucun objectif trouvé</h3>
                    <p class="text-muted-foreground mt-1 max-w-sm mx-auto">
                        {% if current_query or current_category != 'all' %}
                            Aucun objectif ne correspond à vos critères de recherche.
                        {% else %}
                            Vous n'avez pas encore défini d'objectif. Commencez dès maintenant à tracer votre chemin.
                        {% endif %}
                    </p>
                    <div class="mt-6">
                        <a href="{{ path('app_goal_new') }}" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">Créer mon premier objectif</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="mt-8 flex justify-center">
            {{ knp_pagination_render(objectifs) }}
        </div>
    </div>
{% endblock %}
