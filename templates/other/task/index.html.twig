{% extends 'base.html.twig' %}

{% block title %}Tâches - LifeOps{% endblock %}

{% block body %}
    {# ── Flash messages ── #}
    {% for msg in app.flashes('success') %}
        <div class="mb-4 rounded-lg border border-[hsl(var(--success))]/30 bg-[hsl(var(--success))]/10 px-4 py-3 text-sm text-[hsl(var(--success))]">
            {{ msg }}
        </div>
    {% endfor %}

    {# ── Header ── #}
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Mes Tâches</h1>
            <p class="text-muted-foreground">Liste complète de vos priorités personnelles</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_taskspace_index') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2 shadow-sm">
                🏢 Mes Projets
            </a>
            <a href="{{ path('app_tasks_board') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                Kanban
            </a>
            <a href="{{ path('app_tasks_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                ➕ Nouvelle Tâche
            </a>
        </div>
    </div>

    {# ── Table ── #}
    <div class="rounded-xl border border-border bg-card text-card-foreground shadow">
        <div class="relative w-full overflow-auto">
            <table class="w-full caption-bottom text-sm">
                <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50">
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Titre</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Statut</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Priorité</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Difficulté</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Projet</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Date limite</th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">Actions</th>
                    </tr>
                </thead>
                <tbody class="[&_tr:last-child]:border-0">
                {% for tache in taches %}
                    <tr class="border-b transition-colors hover:bg-muted/50">

                        {# Titre #}
                        <td class="p-4 align-middle font-medium">{{ tache.titre }}</td>

                        {# Statut #}
                        <td class="p-4 align-middle">
                            {% set statutLabel = {
                                'todo': 'À faire',
                                'in-progress': 'En cours',
                                'review': 'En révision',
                                'done': 'Terminé'
                            } %}
                            <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold
                                {% if tache.statut == 'done' %}border-transparent bg-[hsl(var(--success))]/20 text-[hsl(var(--success))]
                                {% elseif tache.statut == 'in-progress' %}border-transparent bg-[hsl(var(--warning))]/20 text-[hsl(var(--warning))]
                                {% elseif tache.statut == 'review' %}border-transparent bg-blue-500/20 text-blue-400
                                {% else %}border-transparent bg-secondary text-secondary-foreground{% endif %}
                            ">
                                {{ statutLabel[tache.statut] ?? tache.statut }}
                            </div>
                        </td>

                        {# Priorité #}
                        <td class="p-4 align-middle">
                            {% set prioLabel = {'low': 'Basse', 'medium': 'Moyenne', 'high': 'Haute'} %}
                            <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold
                                {% if tache.priorite == 'high' %}border-transparent bg-destructive/20 text-destructive
                                {% elseif tache.priorite == 'medium' %}border-transparent bg-[hsl(var(--warning))]/20 text-[hsl(var(--warning))]
                                {% else %}border-transparent bg-secondary text-secondary-foreground{% endif %}
                            ">
                                {{ prioLabel[tache.priorite] ?? tache.priorite }}
                            </div>
                        </td>

                        {# Difficulté #}
                        <td class="p-4 align-middle">
                            <div class="flex items-center gap-0.5">
                                {% for i in 1..5 %}
                                    <div class="h-1.5 w-3 rounded-full {{ i <= tache.difficulte ? 'bg-primary' : 'bg-muted' }}"></div>
                                {% endfor %}
                            </div>
                        </td>

                        {# Projet #}
                        <td class="p-4 align-middle">
                            {% if tache.taskSpace %}
                                <a href="{{ path('app_taskspace_board', {id: tache.taskSpace.id}) }}"
                                   class="text-primary hover:underline text-xs">
                                    {{ tache.taskSpace.nom }}
                                </a>
                            {% else %}
                                <span class="text-muted-foreground text-xs">Solo</span>
                            {% endif %}
                        </td>

                        {# Deadline #}
                        <td class="p-4 align-middle">
                            {% if tache.deadline %}
                                {% set overdue = tache.deadline < date() and tache.statut != 'done' %}
                                <span class="{{ overdue ? 'text-destructive' : 'text-muted-foreground' }}">
                                    {{ tache.deadline|date('d/m/Y') }}
                                    {% if overdue %}<span class="ml-1">⚠</span>{% endif %}
                                </span>
                            {% else %}
                                <span class="text-muted-foreground">—</span>
                            {% endif %}
                        </td>

                        {# Actions #}
                        <td class="p-4 align-middle text-right">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('app_tasks_show', {id: tache.id}) }}"
                                   class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-input bg-transparent text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
                                   title="Voir">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                </a>
                                <a href="{{ path('app_tasks_edit', {id: tache.id}) }}"
                                   class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-input bg-transparent text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
                                   title="Modifier">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                </a>
                                <form method="post" action="{{ path('app_tasks_delete', {id: tache.id}) }}"
                                      onsubmit="return confirm('Supprimer cette tâche ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tache.id) }}">
                                    <button type="submit"
                                            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-input bg-transparent text-sm font-medium shadow-sm transition-colors hover:bg-destructive/10 hover:text-destructive hover:border-destructive/30"
                                            title="Supprimer">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="3 6 5 6 21 6"/><path d="m19 6-.867 12.142A2 2 0 0 1 16.138 20H7.862a2 2 0 0 1-1.995-1.858L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>

                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="p-8 text-center text-muted-foreground">
                            <div class="flex flex-col items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground/40"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                                <span>Aucune tâche trouvée</span>
                                <a href="{{ path('app_tasks_new') }}" class="text-primary hover:underline text-sm">Créer votre première tâche</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
