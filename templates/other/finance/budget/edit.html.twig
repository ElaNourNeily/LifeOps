{% extends 'base.html.twig' %}

{% block title %}Modifier Budget - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto">
        <div class="mb-8">
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Modifier le Budget</h1>
            <p class="text-muted-foreground">Budget du mois {{ budget.mois }}</p>
        </div>

        <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            {% for field in form %}
                {% if field.vars.name != '_token' %}
                    <div>
                        {{ form_label(field, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-1'}}) }}
                        {{ form_widget(field, {'attr': {'class': 'w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2'}}) }}
                        {{ form_errors(field, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
                    </div>
                {% endif %}
            {% endfor %}

            <div class="flex items-center justify-between pt-4">
                <div class="flex items-center gap-4">
                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        Enregistrer
                    </button>
                    <a href="{{ path('app_finance_index') }}" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}

                {# Delete form — separate from the edit form #}
                <form method="post" action="{{ path('app_budget_delete', {'id': budget.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce budget ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id) }}">
                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-destructive text-destructive-foreground hover:bg-destructive/90 h-10 px-4 py-2">
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
