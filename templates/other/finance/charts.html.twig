{% extends 'base.html.twig' %}

{% block title %}Tableaux de Bord - LifeOps{% endblock %}

{% block body %}
    <div class="p-6 space-y-8">
        {# Header #}
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold">📊 Tableaux de Bord</h1>
                <p class="text-muted-foreground">Visualisez vos finances</p>
            </div>
            <div class="flex gap-4 items-center">
                <form method="get" action="{{ path('app_finance_charts') }}" class="flex items-center gap-2">
                    <select name="year" onchange="this.form.submit()" class="px-3 py-2 border rounded bg-card text-card-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring">
                        <option value="">Toutes les années</option>
                        {% for year in availableYears %}
                            <option value="{{ year }}" {{ selectedYear == year ? 'selected' : '' }}>{{ year }}</option>
                        {% endfor %}
                    </select>
                </form>
                <a href="{{ path('app_finance_index') }}" class="px-4 py-2 border rounded hover:bg-muted text-sm">← Retour</a>
            </div>
        </div>

        {# Stats #}
        <div class="grid grid-cols-3 gap-4">
            <div class="border rounded p-4 bg-card">
                <p class="text-sm text-muted-foreground">Budget Total</p>
                <p class="text-2xl font-bold">{{ summaryStats.totalBudget|number_format(2, ',', ' ') }} €</p>
            </div>
            <div class="border rounded p-4 bg-card">
                <p class="text-sm text-muted-foreground">Total Dépensé</p>
                <p class="text-2xl font-bold">{{ summaryStats.totalSpent|number_format(2, ',', ' ') }} €</p>
            </div>
            <div class="border rounded p-4 bg-card">
                <p class="text-sm text-muted-foreground">Reste</p>
                <p class="text-2xl font-bold {{ summaryStats.totalRemaining < 0 ? 'text-red-500' : 'text-green-500' }}">{{ summaryStats.totalRemaining|number_format(2, ',', ' ') }} €</p>
            </div>
        </div>

        {# Charts Grid #}
        <div class="grid grid-cols-2 gap-6">
            <div class="border rounded p-4 bg-card">
                <h3 class="font-bold mb-4">Dépenses par Catégorie</h3>
                {{ render_chart(expensesByCategoryChart) }}
            </div>
            <div class="border rounded p-4 bg-card">
                <h3 class="font-bold mb-4">Tendance Mensuelle</h3>
                {{ render_chart(monthlySpendingChart) }}
            </div>
            <div class="border rounded p-4 bg-card">
                <h3 class="font-bold mb-4">Revenu vs Dépenses</h3>
                {{ render_chart(budgetVsActualChart) }}
            </div>
            <div class="border rounded p-4 bg-card">
                <h3 class="font-bold mb-4">Consommation Budget</h3>
                {{ render_chart(budgetConsumptionChart) }}
            </div>
        </div>
    </div>
{% endblock %}
