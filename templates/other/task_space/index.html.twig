{% extends 'base.html.twig' %}
{% block title %}Mes Projets - LifeOps{% endblock %}
{% block body %}

{% for msg in app.flashes('success') %}
<div class="mb-4 rounded-lg border border-[hsl(var(--success))]/30 bg-[hsl(var(--success))]/10 px-4 py-3 text-sm text-[hsl(var(--success))]">{{ msg }}</div>
{% endfor %}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 border-b border-border pb-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Espaces de travail collaboratifs</h1>
        <p class="text-muted-foreground mt-1">Gérez vos projets d'équipe et partagez vos tâches</p>
    </div>
    <div class="flex items-center gap-3">
        <a href="{{ path('app_tasks_board') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-secondary text-secondary-foreground hover:bg-secondary/80 h-10 px-4 py-2 shadow-sm">
            👤 Mes Tâches Perso
        </a>
        <a href="{{ path('app_taskspace_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 shadow-sm">
            ➕ Nouveau Projet
        </a>
    </div>
</div>

<div class="mb-10">
    <h2 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-2">👑 Projets dont je suis le Leader</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for ts in myProjects %}
            <div class="group rounded-xl border border-border bg-card text-card-foreground shadow-sm hover:shadow-md hover:border-primary/50 transition-all duration-200 flex flex-col p-5">
                <div class="flex items-start justify-between mb-3">
                    <h3 class="text-lg font-bold text-foreground group-hover:text-primary transition-colors line-clamp-1">{{ ts.nom }}</h3>
                    <div class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold {{ ts.status == 'Active' ? 'border-transparent bg-[hsl(var(--success))]/20 text-[hsl(var(--success))]' : 'border-transparent bg-secondary text-secondary-foreground' }}">
                        {{ ts.status == 'Active' ? 'Actif' : 'Fermé' }}
                    </div>
                </div>
                <p class="text-sm text-muted-foreground mb-4 line-clamp-2 flex-grow">{{ ts.description|default('Aucune description.') }}</p>
                <div class="flex items-center justify-between pt-4 border-t border-border mt-auto">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <span class="font-medium bg-primary/10 text-primary px-2 py-1 rounded-md">{{ ts.type == 'group' ? '👥 Groupe' : '👤 Solo' }}</span>
                    </div>
                    <a href="{{ path('app_taskspace_board', {id: ts.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3">
                        Gérer le projet →
                    </a>
                </div>
            </div>
        {% else %}
            <div class="col-span-full rounded-xl border border-dashed border-border p-8 text-center bg-muted/20">
                <p class="text-muted-foreground mb-3">Vous ne dirigez aucun projet pour le moment.</p>
                <a href="{{ path('app_taskspace_new') }}" class="text-primary hover:underline font-medium">Créer mon premier projet</a>
            </div>
        {% endfor %}
    </div>
</div>

{% if memberProjects is not empty %}
<div>
    <h2 class="text-xl font-semibold text-foreground mb-4 flex items-center gap-2">🤝 Projets où je suis Membre</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for ts in memberProjects %}
            <div class="rounded-xl border border-border bg-card text-card-foreground shadow-sm hover:shadow-md transition-all flex flex-col p-5">
                <div class="flex items-start justify-between mb-3">
                    <div>
                        <h3 class="text-lg font-bold text-foreground">{{ ts.nom }}</h3>
                        <p class="text-xs text-muted-foreground mt-1">Leader : {{ ts.utilisateur.prenom }} {{ ts.utilisateur.nom }}</p>
                    </div>
                </div>
                <a href="{{ path('app_taskspace_board', {id: ts.id}) }}" class="mt-auto inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-9 px-4 w-full">
                    Voir mes tâches assignées →
                </a>
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}