{% extends 'base.html.twig' %}
{% block title %}{{ taskSpace.nom }} — Kanban - LifeOps{% endblock %}
{% block body %}

{% for msg in app.flashes('success') %}
<div class="mb-4 rounded-lg border border-[hsl(var(--success))]/30 bg-[hsl(var(--success))]/10 px-4 py-3 text-sm text-[hsl(var(--success))]">{{ msg }}</div>
{% endfor %}

<div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6 border-b border-border pb-4">
    <div>
        <div class="flex items-center gap-2 mb-2 text-sm text-muted-foreground">
            <a href="{{ path('app_taskspace_index') }}" class="hover:text-primary transition-colors">🏢 Mes Projets</a>
            <span>/</span>
            <span class="text-foreground font-medium">{{ taskSpace.nom }}</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground flex items-center gap-3">
            {{ taskSpace.nom }}
            {% if isLeader %}
                <span class="text-xs font-bold bg-warning/20 text-warning px-2 py-1 rounded-md uppercase tracking-wider">👑 Leader</span>
            {% else %}
                <span class="text-xs font-bold bg-primary/20 text-primary px-2 py-1 rounded-md uppercase tracking-wider">👤 Membre</span>
            {% endif %}
        </h1>
    </div>

    {% if isLeader %}
    <div class="flex items-center gap-2">
        <a href="{{ path('app_taskspace_assign', {id: taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4">
            ➕ Assigner
        </a>
        <a href="{{ path('app_taskspace_invite', {id: taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-9 px-4">
            👥 Équipe
        </a>
        <a href="{{ path('app_taskspace_edit', {id: taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-9 px-4">
            ⚙️ Paramètres
        </a>
    </div>
    {% endif %}
</div>

{% set colConfig = {
    'todo':        {'label': 'À faire',      'dot': 'bg-secondary',             'count_class': 'bg-secondary text-secondary-foreground'},
    'in-progress': {'label': 'En cours',     'dot': 'bg-[hsl(var(--warning))]', 'count_class': 'bg-[hsl(var(--warning))]/20 text-[hsl(var(--warning))]'},
    'review':      {'label': 'En révision',  'dot': 'bg-blue-500',              'count_class': 'bg-blue-500/20 text-blue-400'},
    'done':        {'label': 'Terminé',      'dot': 'bg-[hsl(var(--success))]', 'count_class': 'bg-[hsl(var(--success))]/20 text-[hsl(var(--success))]'}
} %}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for colKey, tasks in columns %}
        {% set cfg = colConfig[colKey] %}
        <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between px-2 py-1 bg-muted/50 rounded-lg border border-border">
                <div class="flex items-center gap-2">
                    <div class="h-2.5 w-2.5 rounded-full {{ cfg.dot }}"></div>
                    <span class="text-sm font-bold text-foreground">{{ cfg.label }}</span>
                </div>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-bold {{ cfg.count_class }}">{{ tasks|length }}</span>
            </div>

            <div class="flex flex-col gap-3 min-h-[250px] p-1">
                {% for tache in tasks %}
                    <div class="relative rounded-xl border border-border bg-card text-card-foreground shadow-sm p-4 flex flex-col gap-3 hover:border-primary/50 transition-all">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold px-2 py-1 rounded-md bg-secondary text-secondary-foreground">{{ tache.priorite|capitalize }}</span>
                            <span class="text-xs text-muted-foreground" title="Assigné à">👤 {{ tache.utilisateur.prenom }}</span>
                        </div>
                        <h4 class="text-sm font-bold">{{ tache.titre }}</h4>
                        
                        <form method="post" action="{{ path('app_tasks_status', {id: tache.id}) }}" class="mt-auto pt-2 border-t border-border">
                            <select name="statut" class="flex h-8 w-full rounded-md border border-input bg-background px-2 text-xs focus-visible:ring-1 focus-visible:ring-ring" onchange="this.form.submit()">
                                <option value="todo"        {{ tache.statut == 'todo'        ? 'selected' : '' }}>À faire</option>
                                <option value="in-progress" {{ tache.statut == 'in-progress' ? 'selected' : '' }}>En cours</option>
                                <option value="review"      {{ tache.statut == 'review'      ? 'selected' : '' }}>En révision</option>
                                {% if isLeader %}
                                <option value="done"        {{ tache.statut == 'done'        ? 'selected' : '' }}>Terminé</option>
                                {% else %}
                                <option value="done" disabled>Terminé (Leader uniquement)</option>
                                {% endif %}
                            </select>
                        </form>
                    </div>
                {% else %}
                    <div class="rounded-xl border border-dashed border-border/60 bg-muted/20 p-6 flex flex-col items-center justify-center text-center min-h-[100px]">
                        <span class="text-sm text-muted-foreground font-medium">Aucune tâche</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}