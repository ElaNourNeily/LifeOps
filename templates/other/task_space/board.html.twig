{% extends 'base.html.twig' %}
{% block title %}{{ taskSpace.nom }} — Kanban - LifeOps{% endblock %}
{% block body %}

{% for msg in app.flashes('success') %}
<div class="mb-4 rounded-lg border border-[hsl(var(--success))]/30 bg-[hsl(var(--success))]/10 px-4 py-3 text-sm text-[hsl(var(--success))]">{{ msg }}</div>
{% endfor %}

<div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6 border-b border-border pb-4">
    <div>
        <div class="flex items-center gap-2 mb-2 text-sm text-muted-foreground">
            <a href="{{ path('app_taskspace_index') }}" class="hover:text-primary transition-colors">🏢 Mes Projets</a>
            <span>/</span>
            <span class="text-foreground font-medium">{{ taskSpace.nom }}</span>
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground flex items-center gap-3">
            {{ taskSpace.nom }}
            {% if isLeader %}
                <span class="text-xs font-bold bg-warning/20 text-warning px-2 py-1 rounded-md uppercase tracking-wider">👑 Leader</span>
            {% else %}
                <span class="text-xs font-bold bg-primary/20 text-primary px-2 py-1 rounded-md uppercase tracking-wider">👤 Membre</span>
            {% endif %}
        </h1>
    </div>

    {% if isLeader %}
    <div class="flex items-center gap-2">
        
        <a href="{{ path('app_taskspace_assign', {id: taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4">
            ➕ Assigner
        </a>
        <a href="{{ path('app_taskspace_invite', {id: taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-9 px-4">
            👥 Équipe
        </a>
        <a href="{{ path('app_taskspace_edit', {id: taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-9 px-4">
            ⚙️ Paramètres
        </a>
        {% if isLeader %}
        <button id="aiAssignBtn" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-primary bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground h-10 px-4 py-2 shadow-sm transition-all">
            🤖 Auto-Assignation IA
        </button>
        {% endif %}
    </div>
    {% endif %}
</div>

{% set colConfig = {
    'todo':        {'label': 'À faire',      'dot': 'bg-secondary',             'count_class': 'bg-secondary text-secondary-foreground'},
    'in-progress': {'label': 'En cours',     'dot': 'bg-[hsl(var(--warning))]', 'count_class': 'bg-[hsl(var(--warning))]/20 text-[hsl(var(--warning))]'},
    'review':      {'label': 'En révision',  'dot': 'bg-blue-500',              'count_class': 'bg-blue-500/20 text-blue-400'},
    'done':        {'label': 'Terminé',      'dot': 'bg-[hsl(var(--success))]', 'count_class': 'bg-[hsl(var(--success))]/20 text-[hsl(var(--success))]'}
} %}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for colKey, tasks in columns %}
        {% set cfg = colConfig[colKey] %}
        <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between px-2 py-1 bg-muted/50 rounded-lg border border-border">
                <div class="flex items-center gap-2">
                    <div class="h-2.5 w-2.5 rounded-full {{ cfg.dot }}"></div>
                    <span class="text-sm font-bold text-foreground">{{ cfg.label }}</span>
                </div>
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-bold {{ cfg.count_class }}">{{ tasks|length }}</span>
            </div>

            <div class="flex flex-col gap-3 min-h-[250px] p-1">
                {% for tache in tasks %}
                    <div class="relative rounded-xl border border-border bg-card text-card-foreground shadow-sm p-4 flex flex-col gap-3 hover:border-primary/50 transition-all">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold px-2 py-1 rounded-md bg-secondary text-secondary-foreground">{{ tache.priorite|capitalize }}</span>
                            <span class="text-xs text-muted-foreground" title="Assigné à">👤 {{ tache.utilisateur.prenom }}</span>
                        </div>
                        <h4 class="text-sm font-bold">{{ tache.titre }}</h4>
                        
                        <form method="post" action="{{ path('app_tasks_status', {id: tache.id}) }}" class="mt-auto pt-2 border-t border-border">
                            <select name="statut" class="flex h-8 w-full rounded-md border border-input bg-background px-2 text-xs focus-visible:ring-1 focus-visible:ring-ring" onchange="this.form.submit()">
                                <option value="todo"        {{ tache.statut == 'todo'        ? 'selected' : '' }}>À faire</option>
                                <option value="in-progress" {{ tache.statut == 'in-progress' ? 'selected' : '' }}>En cours</option>
                                <option value="review"      {{ tache.statut == 'review'      ? 'selected' : '' }}>En révision</option>
                                {% if isLeader %}
                                <option value="done"        {{ tache.statut == 'done'        ? 'selected' : '' }}>Terminé</option>
                                {% else %}
                                <option value="done" disabled>Terminé (Leader uniquement)</option>
                                {% endif %}
                            </select>
                        </form>
                    </div>
                {% else %}
                    <div class="rounded-xl border border-dashed border-border/60 bg-muted/20 p-6 flex flex-col items-center justify-center text-center min-h-[100px]">
                        <span class="text-sm text-muted-foreground font-medium">Aucune tâche</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>
{# MODALE IA ASSIGNATION #}
<div id="aiAssignModal" class="fixed inset-0 bg-background/80 backdrop-blur-sm hidden items-center justify-center z-50 transition-all duration-200">
    <div class="bg-card border border-border rounded-xl shadow-2xl w-[650px] max-w-[90%] p-6">
        <div class="flex justify-between items-center mb-5 border-b border-border pb-3">
            <h3 class="text-xl font-bold text-foreground flex items-center gap-2">
                <span class="text-primary">✨</span> Répartition Intelligente Gemini
            </h3>
            <button onclick="closeAiAssignModal()" class="text-muted-foreground hover:text-foreground hover:bg-muted rounded-full p-1">✕</button>
        </div>
        <div id="aiAssignContent" class="text-sm space-y-4 text-foreground max-h-[60vh] overflow-y-auto">
            Chargement de l'analyse IA...
        </div>
        <div id="aiAssignFooter" class="flex justify-end gap-2 mt-6 pt-4 border-t border-border hidden">
            <button onclick="closeAiAssignModal()" class="px-4 py-2 rounded-md border text-sm font-medium">Refuser</button>
            <button onclick="applyAiAssignments()" class="px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90">
                ✅ Accepter & Assigner
            </button>
        </div>
    </div>
</div>

<script>
    const aiAssignBtn = document.getElementById("aiAssignBtn");
    const assignModal = document.getElementById("aiAssignModal");
    const assignContent = document.getElementById("aiAssignContent");
    const assignFooter = document.getElementById("aiAssignFooter");
    let pendingSuggestions = [];

    if (aiAssignBtn) {
        aiAssignBtn.addEventListener("click", async () => {
            assignModal.classList.remove("hidden"); 
            assignModal.classList.add("flex");
            assignContent.innerHTML = "<div class='flex flex-col items-center justify-center p-8 gap-4'><div class='animate-spin h-10 w-10 border-4 border-primary border-t-transparent rounded-full'></div><p class='text-muted-foreground'>Gemini analyse les tâches et l'équipe...</p></div>";
            assignFooter.classList.add("hidden");

            try {
                const response = await fetch("{{ path('app_taskspace_ai_assign', {id: taskSpace.id}) }}");
                const data = await response.json();
                pendingSuggestions = data.suggestions || [];

                if (pendingSuggestions.length === 0) {
                    assignContent.innerHTML = "<div class='text-center py-6'><p class='text-lg font-medium text-foreground'>Aucune tâche 'À faire' à assigner, ou erreur IA.</p></div>";
                    return;
                }

                let html = "<p class='mb-4 text-muted-foreground'>Gemini a analysé le contexte et propose cette répartition pour équilibrer l'équipe :</p><ul class='space-y-3'>";
                pendingSuggestions.forEach(sugg => {
                    html += `
                        <li class="p-4 bg-muted/20 border border-border rounded-lg shadow-sm">
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-foreground text-base">${sugg.task_title}</span>
                                <span class="flex items-center gap-2 text-primary font-bold bg-primary/10 px-3 py-1 rounded-full text-sm">
                                    ➔ ${sugg.member_name}
                                </span>
                            </div>
                            <p class="text-xs text-muted-foreground italic border-l-2 border-primary/50 pl-2 mt-2">
                                🤖 " ${sugg.justification || 'Assignation automatique pour équilibrer la charge.'} "
                            </p>
                        </li>`;
                });
                html += "</ul>";
                assignContent.innerHTML = html;
                assignFooter.classList.remove("hidden");
            } catch (e) {
                assignContent.innerHTML = "<p class='text-destructive'>Erreur de connexion à l'IA Gemini.</p>";
            }
        });
    }

    async function applyAiAssignments() {
        assignContent.innerHTML = "<div class='text-center py-6'><p class='font-bold text-primary'>Application des choix de l'IA en cours...</p></div>";
        assignFooter.classList.add("hidden");
        
        await fetch("{{ path('app_taskspace_ai_assign_apply', {id: taskSpace.id}) }}", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ suggestions: pendingSuggestions })
        });
        
        window.location.reload(); 
    }

    function closeAiAssignModal() { 
        assignModal.classList.add("hidden"); 
        assignModal.classList.remove("flex"); 
    }
</script>
{% endblock %}