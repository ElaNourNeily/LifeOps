{#
    _group_projects_widget.html.twig
    ─────────────────────────────────
    Include this on your dashboard with:
        {% include 'other/task_space/_group_projects_widget.html.twig' %}

    The controller that renders the dashboard must pass:
        memberProjects  — array of TaskSpace entities where user is a member
        recentGroupTasks — array of recently assigned Tache entities (optional)
#}

{% if memberProjects is defined and memberProjects|length > 0 %}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-circle p-2">
                <i class="bi bi-people-fill"></i>
            </span>
            <h6 class="mb-0 fw-semibold">Mes projets de groupe</h6>
        </div>
        <span class="badge bg-primary bg-opacity-10 text-primary">
            {{ memberProjects|length }} projet{{ memberProjects|length > 1 ? 's' : '' }}
        </span>
    </div>

    <div class="card-body p-0">
        <ul class="list-group list-group-flush">
            {% for project in memberProjects %}
            <li class="list-group-item px-4 py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="mb-0 fw-semibold text-dark">{{ project.nom }}</p>
                        <small class="text-muted">
                            Leader :
                            <span class="fw-medium">
                                {{ project.utilisateur.prenom }} {{ project.utilisateur.nom }}
                            </span>
                            &bull; {{ project.type }}
                        </small>
                    </div>
                    <a href="{{ path('app_taskspace_board', { id: project.id }) }}"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-kanban me-1"></i> Voir mon board
                    </a>
                </div>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endif %}

{# ── Recent task assignments notification ──────────────────────── #}
{% if recentGroupTasks is defined and recentGroupTasks|length > 0 %}
<div class="alert alert-info alert-dismissible fade show d-flex gap-3 align-items-start" role="alert">
    <i class="bi bi-bell-fill fs-5 mt-1 text-info"></i>
    <div>
        <strong>Nouvelles tâches assignées !</strong>
        <ul class="mb-0 mt-1 ps-3">
            {% for task in recentGroupTasks %}
            <li>
                <a href="{{ path('app_taskspace_board', { id: task.taskSpace.id }) }}" class="text-decoration-none">
                    <strong>{{ task.titre }}</strong>
                </a>
                — dans le projet
                <em>{{ task.taskSpace.nom }}</em>
                <span class="badge bg-{{ task.priorite == 'urgent' ? 'danger' : (task.priorite == 'high' ? 'warning text-dark' : 'secondary') }} ms-1">
                    {{ task.priorite }}
                </span>
            </li>
            {% endfor %}
        </ul>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}
