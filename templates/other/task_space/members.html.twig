{% extends 'base.html.twig' %}
{% block title %}Membres — {{ taskSpace.nom }} - LifeOps{% endblock %}
{% block body %}

{% for msg in app.flashes('success') %}
<div class="mb-4 rounded-lg border border-[hsl(var(--success))]/30 bg-[hsl(var(--success))]/10 px-4 py-3 text-sm text-[hsl(var(--success))]">{{ msg }}</div>
{% endfor %}

{# Breadcrumb #}
<div class="flex items-center gap-2 mb-6 text-xs text-muted-foreground">
    <a href="{{ path('app_taskspace_index') }}" class="hover:text-foreground">Projets</a>
    <span>/</span>
    <a href="{{ path('app_taskspace_board', {id: taskSpace.id}) }}" class="hover:text-foreground">{{ taskSpace.nom }}</a>
    <span>/</span>
    <span class="text-foreground">Membres</span>
</div>

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Gestion des membres</h1>
        <p class="text-muted-foreground">{{ taskSpace.nom }} — répartition de la charge de travail</p>
    </div>
    <div class="flex gap-2">
        <a href="{{ path('app_taskspace_invite', {id: taskSpace.id}) }}"
           class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-10 px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
            Inviter
        </a>
        <a href="{{ path('app_taskspace_assign', {id: taskSpace.id}) }}"
           class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Assigner une tâche
        </a>
    </div>
</div>

{# ── Global stats ── #}
<div class="grid grid-cols-4 gap-4 mb-8">
    {% set statColors = {'todo': 'text-muted-foreground', 'in-progress': 'text-[hsl(var(--warning))]', 'review': 'text-blue-400', 'done': 'text-[hsl(var(--success))]'} %}
    {% set statLabels = {'todo': 'À faire', 'in-progress': 'En cours', 'review': 'En révision', 'done': 'Terminées'} %}
    {% for key, label in statLabels %}
        <div class="rounded-xl border border-border bg-card p-4">
            <p class="text-xs text-muted-foreground mb-1">{{ label }}</p>
            <p class="text-2xl font-bold {{ statColors[key] }}">{{ stats[key] ?? 0 }}</p>
        </div>
    {% endfor %}
</div>

{# ── Per-member workload ── #}
{% if memberDetails is empty %}
    <div class="rounded-xl border border-dashed border-border bg-card/50 p-12 text-center">
        <p class="text-muted-foreground">Aucun membre pour l'instant.</p>
        <a href="{{ path('app_taskspace_invite', {id: taskSpace.id}) }}" class="text-primary hover:underline text-sm mt-2 inline-block">Inviter des membres →</a>
    </div>
{% else %}
    <div class="space-y-4">
        {% for detail in memberDetails %}
            {% set member = detail.user %}
            {% set total = detail.total %}
            {% set cols  = detail.cols %}
            {% set donePct = total > 0 ? ((cols.done / total) * 100)|round : 0 %}

            <div class="rounded-xl border border-border bg-card text-card-foreground shadow">
                <div class="p-5">
                    {# Member header #}
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-bold">
                                {{ member.prenom|first|upper }}{{ member.nom|first|upper }}
                            </div>
                            <div>
                                <p class="font-semibold text-foreground">{{ member.prenom }} {{ member.nom }}</p>
                                <p class="text-xs text-muted-foreground">{{ member.email }}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <p class="text-xs text-muted-foreground">Charge</p>
                                <p class="text-sm font-bold text-foreground">{{ total }} tâche{{ total != 1 ? 's' : '' }}</p>
                            </div>
                            <div class="flex gap-2">
                                <a href="{{ path('app_taskspace_assign', {id: taskSpace.id}) }}?member={{ member.id }}"
                                   class="inline-flex items-center justify-center rounded-md text-xs font-medium border border-input bg-background hover:bg-accent h-8 px-3">
                                    + Tâche
                                </a>
                                <form method="post" action="{{ path('app_taskspace_remove_member', {'id': taskSpace.id, 'memberId': detail.user.id}) }}"
                                      onsubmit="return confirm('Retirer {{ member.prenom }} du projet ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remove-member-' ~ member.id) }}">
                                    <button class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-input bg-transparent transition-colors hover:bg-destructive/10 hover:text-destructive hover:border-destructive/30">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    {# Mini stats #}
                    <div class="grid grid-cols-4 gap-2 mb-3 text-center">
                        {% for key, label in {'todo': 'À faire', 'in-progress': 'En cours', 'review': 'Révision', 'done': 'Terminé'} %}
                            <div class="rounded-lg bg-muted/40 py-2">
                                <p class="text-sm font-bold text-foreground">{{ cols[key] ?? 0 }}</p>
                                <p class="text-xs text-muted-foreground">{{ label }}</p>
                            </div>
                        {% endfor %}
                    </div>

                    {# Progress #}
                    <div class="flex items-center gap-3 mb-4">
                        <div class="flex-1 h-1.5 rounded-full bg-muted overflow-hidden">
                            <div class="h-full rounded-full bg-primary" style="width: {{ donePct }}%"></div>
                        </div>
                        <span class="text-xs text-muted-foreground w-8 text-right">{{ donePct }}%</span>
                    </div>

                    {# Tasks list #}
                    {% if detail.tasks is not empty %}
                        <div class="border-t border-border pt-3">
                            <div class="relative w-full overflow-auto">
                                <table class="w-full caption-bottom text-sm">
                                    <thead>
                                        <tr class="border-b transition-colors">
                                            <th class="h-9 px-3 text-left align-middle font-medium text-muted-foreground text-xs">Tâche</th>
                                            <th class="h-9 px-3 text-left align-middle font-medium text-muted-foreground text-xs">Statut</th>
                                            <th class="h-9 px-3 text-left align-middle font-medium text-muted-foreground text-xs">Priorité</th>
                                            <th class="h-9 px-3 text-left align-middle font-medium text-muted-foreground text-xs">Deadline</th>
                                            <th class="h-9 px-3 text-right align-middle font-medium text-muted-foreground text-xs">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="[&_tr:last-child]:border-0">
                                        {% for tache in detail.tasks %}
                                            <tr class="border-b transition-colors hover:bg-muted/50">
                                                <td class="p-3 align-middle font-medium text-xs">{{ tache.titre }}</td>
                                                <td class="p-3 align-middle">
                                                    {% set sLabel = {'todo': 'À faire', 'in-progress': 'En cours', 'review': 'Révision', 'done': 'Terminé'} %}
                                                    <div class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold
                                                        {% if tache.statut == 'done' %}border-transparent bg-[hsl(var(--success))]/20 text-[hsl(var(--success))]
                                                        {% elseif tache.statut == 'in-progress' %}border-transparent bg-[hsl(var(--warning))]/20 text-[hsl(var(--warning))]
                                                        {% elseif tache.statut == 'review' %}border-transparent bg-blue-500/20 text-blue-400
                                                        {% else %}border-transparent bg-secondary text-secondary-foreground{% endif %}">
                                                        {{ sLabel[tache.statut] ?? tache.statut }}
                                                    </div>
                                                </td>
                                                <td class="p-3 align-middle">
                                                    {% set pLabel = {'low': 'Basse', 'medium': 'Moyenne', 'high': 'Haute'} %}
                                                    <div class="inline-flex items-center rounded-full border px-2 py-0.5 text-xs font-semibold
                                                        {% if tache.priorite == 'high' %}border-transparent bg-destructive/20 text-destructive
                                                        {% elseif tache.priorite == 'medium' %}border-transparent bg-[hsl(var(--warning))]/20 text-[hsl(var(--warning))]
                                                        {% else %}border-transparent bg-secondary text-secondary-foreground{% endif %}">
                                                        {{ pLabel[tache.priorite] ?? tache.priorite }}
                                                    </div>
                                                </td>
                                                <td class="p-3 align-middle text-xs text-muted-foreground">
                                                    {{ tache.deadline ? tache.deadline|date('d/m/Y') : '—' }}
                                                </td>
                                                <td class="p-3 align-middle text-right">
                                                    <div class="flex justify-end gap-1">
                                                        {# Validate (Leader marks as done) #}
                                                        {% if tache.statut != 'done' %}
                                                            <form method="POST" action="{{ path('app_taskspace_validate', {id: taskSpace.id, taskId: tache.id}) }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('validate-' ~ tache.id) }}">
                                                                <button type="submit"
                                                                        class="inline-flex h-7 items-center justify-center rounded-md border border-[hsl(var(--success))]/30 bg-[hsl(var(--success))]/10 text-[hsl(var(--success))] hover:bg-[hsl(var(--success))]/20 transition-colors text-xs px-2"
                                                                        title="Valider">
                                                                    ✓ Valider
                                                                </button>
                                                            </form>
                                                        {% endif %}
                                                        {# Edit #}
                                                        <a href="{{ path('app_tasks_edit', {id: tache.id}) }}"
                                                           class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-input bg-transparent transition-colors hover:bg-accent">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{% endblock %}
