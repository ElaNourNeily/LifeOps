{% extends 'base.html.twig' %}
{% block title %}Assigner une tâche — {{ taskSpace.nom }} - LifeOps{% endblock %}
{% block body %}

<div class="max-w-2xl mx-auto">
    {# Breadcrumb #}
    <div class="flex items-center gap-2 mb-6 text-xs text-muted-foreground">
        <a href="{{ path('app_taskspace_index') }}" class="hover:text-foreground">Projets</a>
        <span>/</span>
        <a href="{{ path('app_taskspace_board', {id: taskSpace.id}) }}" class="hover:text-foreground">{{ taskSpace.nom }}</a>
        <span>/</span>
        <span class="text-foreground">Assigner une tâche</span>
    </div>

    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-foreground">Assigner une tâche</h1>
        <p class="text-muted-foreground">Créer et assigner une tâche à un membre de <strong>{{ taskSpace.nom }}</strong></p>
    </div>

    {% if members is empty %}
        <div class="rounded-xl border border-dashed border-border bg-card/50 p-10 text-center">
            <p class="text-sm text-muted-foreground mb-2">Aucun membre dans ce projet.</p>
            <a href="{{ path('app_taskspace_invite', {id: taskSpace.id}) }}"
               class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4">
                Inviter des membres d'abord
            </a>
        </div>
    {% else %}
        <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            {# Assignee #}
            <div>
                {{ form_label(form.utilisateur, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                {{ form_widget(form.utilisateur, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                {{ form_errors(form.utilisateur, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
            </div>

            {# Title #}
            <div>
                {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            {# Priority + Difficulty #}
            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.priorite, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                    {{ form_widget(form.priorite, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    {{ form_errors(form.priorite) }}
                </div>
                <div>
                    {{ form_label(form.difficulte, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                    {{ form_widget(form.difficulte, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    {{ form_errors(form.difficulte) }}
                </div>
            </div>

            {# Deadline #}
            <div>
                {{ form_label(form.deadline, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                {{ form_widget(form.deadline, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                {{ form_errors(form.deadline) }}
            </div>

            {# Description #}
            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                {{ form_errors(form.description) }}
            </div>

            {# Buttons #}
            <div class="flex justify-end gap-2">
                <a href="{{ path('app_taskspace_board', {id: taskSpace.id}) }}"
                   class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    Annuler
                </a>
                <button type="submit"
                        class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                    Assigner la tâche
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    {% endif %}
</div>

{% endblock %}
