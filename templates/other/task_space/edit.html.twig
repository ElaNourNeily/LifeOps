{% extends 'base.html.twig' %}
{% block title %}Modifier Projet - LifeOps{% endblock %}
{% block body %}
    <div class="max-w-2xl mx-auto">
        <div class="mb-8 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-foreground">Modifier Projet</h1>
                <p class="text-muted-foreground">{{ taskSpace.nom }}</p>
            </div>
            <form method="post" action="{{ path('app_taskspace_delete', {id: taskSpace.id}) }}" onsubmit="return confirm('Supprimer ce projet et TOUTES ses tâches ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ taskSpace.id) }}">
                <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-destructive text-destructive-foreground hover:bg-destructive/90 h-10 px-4 py-2">
                    🗑️ Supprimer
                </button>
            </form>
        </div>
        <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
            {{ include('other/task_space/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
{% endblock %}