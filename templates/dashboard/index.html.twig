{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - {% endblock %}

{% block body %}
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-foreground text-balance">
            Tableau de bord
        </h1>
        <p class="mt-1 text-muted-foreground">
            Vue d'ensemble de votre vie personnelle
        </p>
    </div>

    {# Stats Grid - Simplified for Time #}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-border bg-card text-card-foreground shadow-sm p-6">
            <div class="flex items-center gap-4">
                <div class="p-2 rounded-lg bg-primary/10">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-muted-foreground">Journées planifiées</p>
                    <div class="flex items-baseline gap-2">
                        <h3 class="text-2xl font-bold">
                            {{ activePlannings|length }}
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Sections #}
    <div class="mt-8 space-y-8">
        {% for planning in activePlannings %}
            {# Today's Schedule Card #}
            <div class="rounded-xl border border-border bg-card p-5">
                <div class="mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="p-2 rounded-lg bg-primary/10 text-primary font-bold text-lg">
                            {{ planning.date|date('d') }}
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-card-foreground leading-none">
                                {{ planning.date|date('l')|trans }}
                            </h2>
                            <p class="text-sm text-muted-foreground">{{ planning.date|date('F Y')|trans }}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_planning_edit', {'date': planning.date|date('Y-m-d')}) }}" class="text-xs text-muted-foreground hover:text-primary transition-colors">
                            ⚙️ Paramètres
                        </a>
                        <a href="{{ path('app_time_index', {'date': planning.date|date('Y-m-d')}) }}" class="flex items-center gap-1 text-sm text-primary hover:underline">
                            Voir calendrier <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>

                <div class="flex flex-col gap-3">
                    {# Activities are iterated directly from the collection #}
                    {% for activite in planning.activites %}
                        <div class="flex items-center gap-4 rounded-xl bg-secondary/20 p-4 border border-border/10 shadow-sm relative overflow-hidden group hover:border-border/40 transition-colors">
                            {# Color Bar #}
                            <div class="absolute left-0 top-0 bottom-0 w-1.5" style="background-color: {{ activite.couleur|default('#3b82f6') }}"></div>
                            
                            <div class="flex-1 pl-2">
                                <h3 class="font-semibold text-base text-foreground tracking-tight leading-none mb-1.5">{{ activite.titre }}</h3>
                                <div class="flex items-center gap-3 text-sm text-muted-foreground">
                                    <span class="flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                        {{ activite.heureDebutEstimee|date('H:i') }} - {{ activite.heureFinEstimee|date('H:i') }}
                                    </span>
                                    {% if activite.categorie %}
                                        <span class="px-2 py-0.5 rounded-full bg-primary/5 border border-primary/10 text-[10px] uppercase tracking-wider font-bold text-primary">
                                            {{ activite.categorie }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
             <div class="rounded-xl border border-dashed border-border bg-card/50 p-12 text-center">
                <div class="rounded-full bg-muted/20 p-3 w-12 h-12 flex items-center justify-center mx-auto mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>
                </div>
                <h3 class="text-lg font-medium text-foreground">Aucune activité prévue</h3>
                <p class="text-sm text-muted-foreground mt-1">Vous n'avez pas encore d'activités programmées pour les jours à venir.</p>
                <div class="mt-6 flex justify-center gap-3">
                    <a href="{{ path('app_time_index') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        Accéder au calendrier
                    </a>
                    <a href="{{ path('app_planning_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent h-10 px-4 py-2">
                        Créer un planning
                    </a>
                </div>
             </div>
        {% endfor %}
    </div>
{% endblock %}
