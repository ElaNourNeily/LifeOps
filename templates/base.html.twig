<!DOCTYPE html>
<html lang="fr" class="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}LifeOps{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧠</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('app.built.css') }}">
        {% endblock %}

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body class="font-sans antialiased bg-background text-foreground min-h-screen flex flex-col md:flex-row">

        {# Sidebar / Mobile Nav #}
        <aside class="w-full md:w-64 bg-card border-r border-border flex-shrink-0 flex flex-col">
            <div class="p-6 border-b border-border">
                <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3">
                    <span class="text-2xl font-bold bg-primary/20 text-primary w-10 h-10 rounded-lg flex items-center justify-center">L</span>
                    <span class="text-2xl font-bold tracking-tight text-foreground">LifeOps</span>
                </a>
            </div>

            <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
                {% set route = app.request.attributes.get('_route') %}

                <a href="{{ path('app_dashboard') }}"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors {{ route == 'app_dashboard' ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-secondary hover:text-foreground' }}">
                   <span>📊</span> Tableau de bord
                </a>

                <div class="space-y-1">
                    <a href="{{ path('app_time_index') }}"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors {{ (route starts with 'app_time' or route starts with 'app_planning') ? 'bg-primary/10 text-primary' : 'text-muted-foreground hover:bg-secondary hover:text-foreground' }}">
                       <span>⏰</span> Temps
                    </a>
                    
                    <div class="pl-9 space-y-1">
                        <a href="{{ path('app_time_index') }}"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-medium transition-colors {{ (route starts with 'app_time' and route != 'app_planning_index') ? 'text-primary font-bold' : 'text-muted-foreground hover:text-foreground' }}">
                           Calendrier
                        </a>
                        <a href="{{ path('app_planning_index') }}"
                           class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-medium transition-colors {{ route starts with 'app_planning' ? 'text-primary font-bold' : 'text-muted-foreground hover:text-foreground' }}">
                           Paramètres
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t border-border">
                <div class="flex items-center gap-3 px-3 py-2 text-sm text-muted-foreground">
                    <div class="w-8 h-8 rounded-full bg-secondary flex items-center justify-center">
                        👤
                    </div>
                    <div>
                        <p class="font-medium text-foreground">Utilisateur</p>
                        <p class="text-xs">Perso</p>
                    </div>
                </div>
            </div>
        </aside>

        {# Main Content #}
        <main class="flex-1 overflow-y-auto bg-background p-4 md:p-8">
            <div class="max-w-7xl mx-auto">
                {% block body %}{% endblock %}
            </div>
        </main>

    </body>
</html>
