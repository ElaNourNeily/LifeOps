{% extends 'base.html.twig' %}

{% block title %}Finances - LifeOps{% endblock %}

{% block body %}
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Gestion Financière</h1>
            <p class="text-muted-foreground">Suivez vos budgets et dépenses</p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_budget_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                Nouveau Budget
            </a>
            <a href="{{ path('app_depense_new') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                Ajouter Dépense
            </a>
        </div>
    </div>

    {# Budget Summaries #}
    {% if budgetSummaries is not empty %}
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-8">
            {% for summary in budgetSummaries %}
                {% set budget = summary.entity %}
                {% set totalDepenses = summary.totalDepenses %}
                
                <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold">Budget {{ budget.mois }}</h2>
                        <span class="text-sm text-muted-foreground">Revenu: {{ budget.revenuMensuel|number_format(2, ',', ' ') }} €</span>
                    </div>
                    
                    {% set percentage = budget.plafond > 0 ? (totalDepenses / budget.plafond) * 100 : 0 %}
                    
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span>Dépenses: {{ totalDepenses|number_format(2, ',', ' ') }} €</span>
                            <span>Plafond: {{ budget.plafond|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="h-2 w-full rounded-full bg-secondary">
                            <div class="h-full rounded-full transition-all duration-500 {{ percentage > 100 ? 'bg-destructive' : (percentage > 80 ? 'bg-[hsl(var(--warning))]' : 'bg-primary') }}" style="width: {{ min(percentage, 100) }}%"></div>
                        </div>
                        <p class="text-xs text-right text-muted-foreground">Reste: {{ (budget.plafond - totalDepenses)|number_format(2, ',', ' ') }} €</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="mb-8 p-6 rounded-xl border border-dashed border-border text-center text-muted-foreground">
            Aucun budget défini. <a href="{{ path('app_budget_new') }}" class="text-primary hover:underline">Créer un budget</a>
        </div>
    {% endif %}

    {# Expenses List #}
    <div class="rounded-xl border border-border bg-card text-card-foreground shadow mb-8">
        <div class="p-6 border-b border-border flex justify-between items-center">
            <h3 class="font-semibold">Historique des dépenses</h3>
            <div class="flex items-center gap-4">
                <a href="{{ path('app_depense_export_pdf', {sort: app.request.query.get('sort'), direction: app.request.query.get('direction'), search: app.request.query.get('search_depense')}) }}" target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    PDF
                </a>
                <form method="get" class="flex gap-2">
                    <input type="hidden" name="sort" value="{{ app.request.query.get('sort') }}">
                    <input type="hidden" name="direction" value="{{ app.request.query.get('direction') }}">
                    <input type="hidden" name="sort_budget" value="{{ app.request.query.get('sort_budget') }}">
                    <input type="hidden" name="dir_budget" value="{{ app.request.query.get('dir_budget') }}">
                    <input type="hidden" name="search_budget" value="{{ app.request.query.get('search_budget') }}">
                    
                    <input type="text" name="search_depense" value="{{ app.request.query.get('search_depense') }}" placeholder="Rechercher (Date, Titre, Catégorie)..." class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50">
                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                        Chercher
                    </button>
                    {% if app.request.query.get('search_depense') %}
                        <a href="{{ path('app_finance_index', {sort: app.request.query.get('sort'), direction: app.request.query.get('direction'), sort_budget: app.request.query.get('sort_budget'), dir_budget: app.request.query.get('dir_budget'), search_budget: app.request.query.get('search_budget')}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                            Effacer
                        </a>
                    {% endif %}
                </form>
            </div>
        </div>
        <div class="relative w-full overflow-auto">
            <table class="w-full caption-bottom text-sm">
                <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                            <a href="{{ path('app_finance_index', {sort: 'date', direction: app.request.query.get('direction') == 'ASC' ? 'DESC' : 'ASC'}) }}" class="flex items-center gap-1 hover:text-foreground">
                                Date
                                {% if app.request.query.get('sort') == 'date' or app.request.query.get('sort') is null %}
                                    <span class="text-xs">{{ app.request.query.get('direction') == 'ASC' ? '↑' : '↓' }}</span>
                                {% endif %}
                            </a>
                        </th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Titre</th>
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Catégorie</th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">
                            <a href="{{ path('app_finance_index', {sort: 'montant', direction: app.request.query.get('direction') == 'ASC' ? 'DESC' : 'ASC'}) }}" class="flex items-center justify-end gap-1 hover:text-foreground">
                                Montant
                                {% if app.request.query.get('sort') == 'montant' %}
                                    <span class="text-xs">{{ app.request.query.get('direction') == 'ASC' ? '↑' : '↓' }}</span>
                                {% endif %}
                            </a>
                        </th>
                        <th class="h-12 px-4 text-center align-middle font-medium text-muted-foreground">Actions</th>
                    </tr>
                </thead>
                <tbody class="[&_tr:last-child]:border-0">
                {% for depense in depenses %}
                    <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                        <td class="p-4 align-middle">{{ depense.date|date('d/m/Y') }}</td>
                        <td class="p-4 align-middle font-medium">{{ depense.titre }}</td>
                        <td class="p-4 align-middle">
                            <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold border-transparent bg-secondary text-secondary-foreground">
                                {{ depense.categorie|capitalize }}
                            </span>
                        </td>
                        <td class="p-4 align-middle text-right text-destructive font-medium">
                            -{{ depense.montant|number_format(2, ',', ' ') }} €
                        </td>
                        <td class="p-4 align-middle text-center">
                            <div class="flex gap-2 justify-center">
                                <a href="{{ path('app_depense_edit', {id: depense.id}) }}" class="inline-flex items-center justify-center rounded-md text-xs font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-8 px-3">
                                    Modifier
                                </a>
                                <form method="POST" action="{{ path('app_depense_delete', {id: depense.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id) }}">
                                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-xs font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-destructive/50 text-destructive hover:bg-destructive/10 h-8 px-3">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="p-4 text-center text-muted-foreground">Aucune dépense enregistrée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Budget List #}
    <div class="rounded-xl border border-border bg-card text-card-foreground shadow">
        <div class="p-6 border-b border-border flex justify-between items-center">
            <h3 class="font-semibold">Historique des budgets</h3>
            <div class="flex items-center gap-4">
                <a href="{{ path('app_budget_export_pdf', {sort: app.request.query.get('sort_budget'), direction: app.request.query.get('dir_budget'), search: app.request.query.get('search_budget')}) }}" target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                    PDF
                </a>
                <form method="get" class="flex gap-2">
                    <input type="hidden" name="sort" value="{{ app.request.query.get('sort') }}">
                    <input type="hidden" name="direction" value="{{ app.request.query.get('direction') }}">
                    <input type="hidden" name="sort_budget" value="{{ app.request.query.get('sort_budget') }}">
                    <input type="hidden" name="dir_budget" value="{{ app.request.query.get('dir_budget') }}">
                    <input type="hidden" name="search_depense" value="{{ app.request.query.get('search_depense') }}">

                    <input type="text" name="search_budget" value="{{ app.request.query.get('search_budget') }}" placeholder="Rechercher (Mois, Revenu)..." class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50">
                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                        Chercher
                    </button>
                    {% if app.request.query.get('search_budget') %}
                        <a href="{{ path('app_finance_index', {sort: app.request.query.get('sort'), direction: app.request.query.get('direction'), sort_budget: app.request.query.get('sort_budget'), dir_budget: app.request.query.get('dir_budget'), search_depense: app.request.query.get('search_depense')}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                            Effacer
                        </a>
                    {% endif %}
                </form>
            </div>
        </div>
        <div class="relative w-full overflow-auto">
            <table class="w-full caption-bottom text-sm">
                <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                        <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">
                            <a href="{{ path('app_finance_index', {sort_budget: 'mois', dir_budget: app.request.query.get('dir_budget') == 'ASC' ? 'DESC' : 'ASC', sort: app.request.query.get('sort'), direction: app.request.query.get('direction')}) }}" class="flex items-center gap-1 hover:text-foreground">
                                Mois
                                {% if app.request.query.get('sort_budget') == 'mois' or app.request.query.get('sort_budget') is null %}
                                    <span class="text-xs">{{ app.request.query.get('dir_budget') == 'ASC' ? '↑' : '↓' }}</span>
                                {% endif %}
                            </a>
                        </th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">
                            <a href="{{ path('app_finance_index', {sort_budget: 'revenu_mensuel', dir_budget: app.request.query.get('dir_budget') == 'ASC' ? 'DESC' : 'ASC', sort: app.request.query.get('sort'), direction: app.request.query.get('direction')}) }}" class="flex items-center justify-end gap-1 hover:text-foreground">
                                Revenu
                                {% if app.request.query.get('sort_budget') == 'revenu_mensuel' %}
                                    <span class="text-xs">{{ app.request.query.get('dir_budget') == 'ASC' ? '↑' : '↓' }}</span>
                                {% endif %}
                            </a>
                        </th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">
                            <a href="{{ path('app_finance_index', {sort_budget: 'plafond', dir_budget: app.request.query.get('dir_budget') == 'ASC' ? 'DESC' : 'ASC', sort: app.request.query.get('sort'), direction: app.request.query.get('direction')}) }}" class="flex items-center justify-end gap-1 hover:text-foreground">
                                Plafond
                                {% if app.request.query.get('sort_budget') == 'plafond' %}
                                    <span class="text-xs">{{ app.request.query.get('dir_budget') == 'ASC' ? '↑' : '↓' }}</span>
                                {% endif %}
                            </a>
                        </th>
                        <th class="h-12 px-4 text-right align-middle font-medium text-muted-foreground">
                            <a href="{{ path('app_finance_index', {sort_budget: 'economies', dir_budget: app.request.query.get('dir_budget') == 'ASC' ? 'DESC' : 'ASC', sort: app.request.query.get('sort'), direction: app.request.query.get('direction')}) }}" class="flex items-center justify-end gap-1 hover:text-foreground">
                                Économies
                                {% if app.request.query.get('sort_budget') == 'economies' %}
                                    <span class="text-xs">{{ app.request.query.get('dir_budget') == 'ASC' ? '↑' : '↓' }}</span>
                                {% endif %}
                            </a>
                        </th>
                        <th class="h-12 px-4 text-center align-middle font-medium text-muted-foreground">Actions</th>
                    </tr>
                </thead>
                <tbody class="[&_tr:last-child]:border-0">
                {% for budget in budgets %}
                    <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
                        <td class="p-4 align-middle font-medium">{{ budget.mois }}</td>
                        <td class="p-4 align-middle text-right">{{ budget.revenuMensuel|number_format(2, ',', ' ') }} €</td>
                        <td class="p-4 align-middle text-right">{{ budget.plafond|number_format(2, ',', ' ') }} €</td>
                        <td class="p-4 align-middle text-right text-primary font-medium">{{ budget.economies|number_format(2, ',', ' ') }} €</td>
                        <td class="p-4 align-middle text-center">
                            <div class="flex gap-2 justify-center">
                                <a href="{{ path('app_budget_edit', {id: budget.id}) }}" class="inline-flex items-center justify-center rounded-md text-xs font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-8 px-3">
                                    Modifier
                                </a>
                                <form method="POST" action="{{ path('app_budget_delete', {id: budget.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ budget.id) }}">
                                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-xs font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-destructive/50 text-destructive hover:bg-destructive/10 h-8 px-3">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="p-4 text-center text-muted-foreground">Aucun budget enregistré.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Audio Alert for Budget Exceeded - Data from Controller #}
    {% if exceededBudgets is not empty %}
    <script>
        let alarmInterval = null;
        let audioContext = null;
        
        // Data from controller
        const exceededBudgets = {{ exceededBudgets|json_encode|raw }};

        document.addEventListener('DOMContentLoaded', function() {
            if (exceededBudgets.length > 0) {
                // Start continuous alarm
                startAlarm();
                
                // Show notification
                const alertDiv = document.createElement('div');
                alertDiv.id = 'budget-alert';
                alertDiv.className = 'fixed top-4 right-4 z-50 p-6 rounded-lg bg-destructive text-destructive-foreground shadow-2xl border-4 border-white';
                alertDiv.innerHTML = `
                    <div class="flex items-center gap-4">
                        <span class="text-4xl animate-bounce">🚨</span>
                        <div>
                            <p class="font-bold text-lg">⚠️ ALERTE BUDGET DÉPASSÉ!</p>
                            <p class="text-sm mt-1">${exceededBudgets.length} budget(s) dépassé(s)</p>
                            <ul class="text-xs mt-2">
                                ${exceededBudgets.map(b => `<li>• ${b.month}: ${b.percentage}% du plafond</li>`).join('')}
                            </ul>
                        </div>
                        <button onclick="stopAlarm()" class="ml-4 px-4 py-2 bg-white text-destructive rounded-md font-bold hover:bg-gray-200 transition-colors">
                            ✕ FERMER
                        </button>
                    </div>
                `;
                document.body.appendChild(alertDiv);
            }
        });

        function startAlarm() {
            try {
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                playAlarmBeep();
                alarmInterval = setInterval(playAlarmBeep, 800);
            } catch (e) {
                console.log('Audio alert not supported:', e);
            }
        }

        function playAlarmBeep() {
            if (!audioContext) return;
            
            // First beep
            const osc1 = audioContext.createOscillator();
            const gain1 = audioContext.createGain();
            osc1.connect(gain1);
            gain1.connect(audioContext.destination);
            osc1.frequency.value = 1200;
            osc1.type = 'square';
            gain1.gain.setValueAtTime(0.5, audioContext.currentTime);
            gain1.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.15);
            osc1.start(audioContext.currentTime);
            osc1.stop(audioContext.currentTime + 0.15);

            // Second beep
            setTimeout(() => {
                if (!audioContext) return;
                const osc2 = audioContext.createOscillator();
                const gain2 = audioContext.createGain();
                osc2.connect(gain2);
                gain2.connect(audioContext.destination);
                osc2.frequency.value = 1500;
                osc2.type = 'square';
                gain2.gain.setValueAtTime(0.5, audioContext.currentTime);
                gain2.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.15);
                osc2.start(audioContext.currentTime);
                osc2.stop(audioContext.currentTime + 0.15);
            }, 150);

            // Third beep
            setTimeout(() => {
                if (!audioContext) return;
                const osc3 = audioContext.createOscillator();
                const gain3 = audioContext.createGain();
                osc3.connect(gain3);
                gain3.connect(audioContext.destination);
                osc3.frequency.value = 1800;
                osc3.type = 'square';
                gain3.gain.setValueAtTime(0.5, audioContext.currentTime);
                gain3.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.2);
                osc3.start(audioContext.currentTime);
                osc3.stop(audioContext.currentTime + 0.2);
            }, 300);
        }

        function stopAlarm() {
            if (alarmInterval) {
                clearInterval(alarmInterval);
                alarmInterval = null;
            }
            if (audioContext) {
                audioContext.close();
                audioContext = null;
            }
            const alertDiv = document.getElementById('budget-alert');
            if (alertDiv) {
                alertDiv.remove();
            }
        }
    </script>
    {% endif %}
{% endblock %}
