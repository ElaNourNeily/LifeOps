<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Planning Hebdomadaire</title>
    <style>
        body { font-family: sans-serif; font-size: 12px; }
        h1 { text-align: center; color: #333; }
        .date-range { text-align: center; margin-bottom: 20px; color: #666; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; vertical-align: top; }
        th { background-color: #f2f2f2; text-align: center; }
        .day-column { width: 14%; }
        .activity { 
            margin-bottom: 5px; 
            padding: 4px; 
            border-radius: 4px; 
            background-color: #f0f0f0;
            border-left: 3px solid #333;
        }
        .activity-time { font-weight: bold; font-size: 10px; display: block; }
        .activity-title { display: block; }
        .activity-category { font-size: 9px; color: #555; font-style: italic; }
    </style>
</head>
<body>
    <h1>Planning Hebdomadaire</h1>
    <div class="date-range">
        Semaine du {{ startOfWeek|date('d/m/Y') }} au {{ endOfWeek|date('d/m/Y') }}
    </div>

    <table>
        <thead>
            <tr>
                {% for date, activities in activitiesByDay %}
                    <th>{{ date|date('D d/m') }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            <tr>
                {% for date, activities in activitiesByDay %}
                    <td class="day-column">
                        {% for activite in activities %}
                            <div class="activity" style="border-left-color: {{ activite.couleur|default('#333') }};">
                                <span class="activity-time">
                                    {{ activite.heureDebutEstimee|date('H:i') }} - {{ activite.heureFinEstimee|date('H:i') }}
                                </span>
                                <span class="activity-title">{{ activite.titre }}</span>
                                {% if activite.categorie %}
                                    <span class="activity-category">{{ activite.categorie }}</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </td>
                {% endfor %}
            </tr>
        </tbody>
    </table>
</body>
</html>
