{% extends 'base.html.twig' %}

{% block title %}Nouvelle Activité - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-xl mx-auto">
        <div class="mb-8">
            <h1 class="text-3xl font-bold tracking-tight text-foreground">Ajouter une Activité</h1>
            <p class="text-muted-foreground">Planifiez votre journée</p>
        </div>

        <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <div>
                    {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                    {{ form_widget(form.titre, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                </div>

                <div class="grid grid-cols-2 gap-4">
                     <div>
                        {{ form_label(form.heureDebutEstimee, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.heureDebutEstimee, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    </div>
                     <div>
                        {{ form_label(form.heureFinEstimee, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.heureFinEstimee, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-4">
                     <div>
                        {{ form_label(form.priorite, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.priorite, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    </div>
                     <div>
                        {{ form_label(form.niveauUrgence, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.niveauUrgence, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    </div>
                     <div>
                        {{ form_label(form.etat, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.etat, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50'}}) }}
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4">
                    <a href="{{ path('app_time_index') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                        Annuler
                    </a>
                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        Enregistrer
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
