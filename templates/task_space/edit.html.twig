{% extends 'base.html.twig' %}

{% block title %}{{ taskSpace.id ? 'Éditer Task Space' : 'Nouveau Task Space' }} - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-3xl mx-auto py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold tracking-tight text-foreground">{{ taskSpace.id ? 'Éditer le Task Space' : 'Créer un Task Space' }}</h1>
            <p class="text-muted-foreground">{{ taskSpace.id ? 'Gérez les membres et les paramètres du Task Space.' : 'Initialisez votre espace de travail collaboratif.' }}</p>
        </div>

        <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <div>
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'}}) }}
                    {{ form_errors(form.nom, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
                </div>

                <div>
                    {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'flex min-h-[100px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'}}) }}
                    {{ form_errors(form.description, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.sprintDuration, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.sprintDuration, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'}}) }}
                        {{ form_errors(form.sprintDuration, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.status, null, {'label_attr': {'class': 'block text-sm font-medium text-foreground mb-2'}}) }}
                        {{ form_widget(form.status, {'attr': {'class': 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2'}}) }}
                        {{ form_errors(form.status, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
                    </div>
                </div>

                <div class="border-t border-border pt-6">
                    <label class="block text-sm font-medium text-foreground mb-2">Mode Collaboration</label>
                    {{ form_widget(form.members, {'attr': {'class': 'flex min-h-[120px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2', 'size': '5'}}) }}
                    {{ form_errors(form.members, {'attr': {'class': 'text-sm text-destructive mt-1'}}) }}
                    <p class="text-xs text-muted-foreground mt-2">Maintenez Ctrl pour sélectionner plusieurs membres.</p>
                </div>

                <div class="flex items-center justify-end gap-4 pt-6 border-t border-border">
                    <a href="{{ path('app_projects_index') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">Annuler</a>
                    <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                         {{ taskSpace.id ? 'Enregistrer les modifications' : 'Créer le Task Space' }}
                    </button>
                </div>
                
            {{ form_end(form) }}
        </div>

        {% if taskSpace.id %}
            <div class="mt-8 p-6 rounded-lg bg-destructive/10 border border-destructive/20">
                <h3 class="text-sm font-bold text-destructive mb-2">Zone de danger</h3>
                <p class="text-xs text-muted-foreground mb-4">La suppression du Task Space supprimera toutes les tâches associées.</p>
                <form method="post" action="{{ path('app_projects_delete', {'id': taskSpace.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce Task Space ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ taskSpace.id) }}">
                    <button class="text-xs font-bold text-destructive hover:underline">Supprimer le Task Space définitivement</button>
                </form>
            </div>
        {% endif %}
    </div>
{% endblock %}
