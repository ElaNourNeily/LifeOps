{% extends 'base.html.twig' %}

{% block title %}{{ taskSpace.nom }} - Task Space - LifeOps{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto py-8">
        {# Header #}
        <div class="flex items-center justify-between mb-8">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <h1 class="text-3xl font-bold tracking-tight text-foreground">{{ taskSpace.nom }}</h1>
                    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold
                        {% if taskSpace.status == 'Active' %}border-transparent bg-green-500/10 text-green-500
                        {% else %}border-transparent bg-secondary text-secondary-foreground{% endif %}">
                        {{ taskSpace.status }}
                    </span>
                </div>
                <p class="text-muted-foreground">{{ taskSpace.description ?: 'Aucune description.' }}</p>
            </div>
            <div class="flex gap-2">
                <a href="{{ path('app_tasks_index') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="m15 18-6-6 6-6"/></svg>
                    Retour aux Tâches
                </a>
                {% if taskSpace.utilisateur == app.user %}
                    <a href="{{ path('app_projects_edit', {'id': taskSpace.id}) }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                        Éditer
                    </a>
                {% endif %}
            </div>
        </div>

        {# Info Cards #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-lg bg-primary/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-primary"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div>
                        <p class="text-sm text-muted-foreground">Membres</p>
                        <p class="text-2xl font-bold">{{ taskSpace.members|length + 1 }}</p>
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-lg bg-blue-500/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-blue-500"><path d="M12 2v10l4.5 4.5"/><circle cx="12" cy="12" r="10"/></svg>
                    </div>
                    <div>
                        <p class="text-sm text-muted-foreground">Durée Sprint</p>
                        <p class="text-2xl font-bold">{{ taskSpace.sprintDuration }} jours</p>
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6">
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-lg bg-purple-500/10">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-purple-500"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    </div>
                    <div>
                        <p class="text-sm text-muted-foreground">Tâches</p>
                        <p class="text-2xl font-bold">{{ taskSpace.taches|length }}</p>
                    </div>
                </div>
            </div>
        </div>

        {# Team Members #}
        <div class="rounded-xl border border-border bg-card text-card-foreground shadow p-6 mb-8">
            <h2 class="text-xl font-bold mb-4">Équipe</h2>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-3 rounded-lg bg-primary/5 border border-primary/20">
                    <div class="flex items-center gap-3">
                        <div class="h-10 w-10 rounded-full bg-primary/20 flex items-center justify-center">
                            <span class="text-sm font-bold text-primary">{{ taskSpace.utilisateur.email|slice(0, 2)|upper }}</span>
                        </div>
                        <div>
                            <p class="font-medium">{{ taskSpace.utilisateur.email }}</p>
                            <p class="text-xs text-muted-foreground">Leader / Créateur</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center rounded-full border border-primary/30 bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">Leader</span>
                </div>

                {% for member in taskSpace.members %}
                    <div class="flex items-center justify-between p-3 rounded-lg hover:bg-accent">
                        <div class="flex items-center gap-3">
                            <div class="h-10 w-10 rounded-full bg-secondary flex items-center justify-center">
                                <span class="text-sm font-bold">{{ member.email|slice(0, 2)|upper }}</span>
                            </div>
                            <div>
                                <p class="font-medium">{{ member.email }}</p>
                                <p class="text-xs text-muted-foreground">Membre</p>
                            </div>
                        </div>
                        <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold">Membre</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# Tasks List #}
        <div class="rounded-xl border border-border bg-card text-card-foreground shadow">
            <div class="p-6 border-b border-border">
                <h2 class="text-xl font-bold">Tâches du Task Space</h2>
            </div>
            <div class="relative w-full overflow-auto">
                <table class="w-full caption-bottom text-sm">
                    <thead class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Titre</th>
                            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Statut</th>
                            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Priorité</th>
                            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Assigné à</th>
                            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Deadline</th>
                        </tr>
                    </thead>
                    <tbody class="[&_tr:last-child]:border-0">
                    {% for tache in taskSpace.taches %}
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <td class="p-4 align-middle font-medium">{{ tache.titre }}</td>
                            <td class="p-4 align-middle">
                                <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold
                                    {% if tache.statut == 'Done' %}border-transparent bg-green-500/20 text-green-500
                                    {% elseif tache.statut == 'InProgress' %}border-transparent bg-blue-500/20 text-blue-500
                                    {% elseif tache.statut == 'Review' %}border-transparent bg-purple-500/20 text-purple-500
                                    {% else %}border-transparent bg-secondary text-secondary-foreground{% endif %}">
                                    {{ tache.statut }}
                                </div>
                            </td>
                            <td class="p-4 align-middle">
                                <span class="text-xs font-medium
                                    {% if tache.priorite == 3 %}text-red-500
                                    {% elseif tache.priorite == 2 %}text-orange-500
                                    {% else %}text-muted-foreground{% endif %}">
                                    {% if tache.priorite == 3 %}Haute
                                    {% elseif tache.priorite == 2 %}Moyenne
                                    {% else %}Basse{% endif %}
                                </span>
                            </td>
                            <td class="p-4 align-middle">
                                <span class="text-xs">{{ tache.assignedTo ? tache.assignedTo.email : 'Non assigné' }}</span>
                            </td>
                            <td class="p-4 align-middle">
                                <span class="text-xs">{{ tache.deadline ? tache.deadline|date('d/m/Y') : '-' }}</span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="p-8 text-center text-muted-foreground">
                                Aucune tâche dans ce Task Space
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
