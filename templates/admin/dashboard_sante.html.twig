{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Dashboard Santé Intelligent{% endblock %}

{% block main %}
    <style>
        .stats-container { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; }
        .stat-card { 
            background: white; padding: 20px; border-radius: 12px; border: 1px solid #ddd;
            flex: 1; min-width: 250px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.2s;
        }
        .stat-card:hover { transform: translateY(-5px); }
        .stat-value { font-size: 2.5rem; font-weight: bold; color: var(--text-color); }
        .stat-label { color: #666; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; }
        .alert-card {
            padding: 20px; border-radius: 12px; margin-bottom: 30px;
            display: flex; align-items: center; gap: 15px; border-left: 5px solid;
        }
        .alert-danger { background: #fef2f2; border-color: #ef4444; color: #991b1b; }
        .alert-success { background: #f0fdf4; border-color: #22c55e; color: #166534; }
        .badge-risk { padding: 5px 12px; border-radius: 20px; font-weight: bold; }
        .badge-high { background: #fee2e2; color: #ef4444; }
    </style>

    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-label">Total Utilisateurs</div>
            <div class="stat-value">{{ totalUsers }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Derniers Bilans (Mois)</div>
            <div class="stat-value">{{ totalBilans }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Utilisateurs à Risque</div>
            <div class="stat-value" style="color: {{ risqueEleve > 0 ? '#ef4444' : '#22c55e' }}">{{ risqueEleve }}</div>
        </div>
    </div>

    {% if risqueEleve > 1 %}
        <div class="alert-card alert-danger">
            <span style="font-size: 2rem;">⚠️</span>
            <div>
                <strong>Alerte Burnout Élevée :</strong> {{ (risqueEleve / totalUsers * 100)|round }}% des utilisateurs présentent des signes de fatigue critique. 
                Une intervention préventive est recommandée.
            </div>
        </div>
    {% else %}
        <div class="alert-card alert-success">
            <span style="font-size: 2rem;">✅</span>
            <div>
                <strong>Situation Stable :</strong> Le niveau de bien-être global des utilisateurs est satisfaisant cette semaine.
            </div>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-md-6">
            <div class="stat-card">
                <h3>Aperçu IA des tendances</h3>
                <p class="text-muted">
                    <i class="fas fa-robot"></i> 
                    Gemini analyse : Les niveaux de stress moyens sont de <strong>{{ avgStress|round(1) }}/10</strong>. 
                    Le sommeil moyen relevé est de <strong>{{ avgSleep|round(1) }}h</strong>.
                </p>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-danger" style="width: {{ avgStress * 10 }}%"></div>
                </div>
                <small>Niveau de stress collectif</small>
            </div>
        </div>
    </div>
{% endblock %}
