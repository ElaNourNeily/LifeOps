{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block body %}
<div class="flex flex-col gap-8">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold text-card-foreground text-balance">Dashboard Admin</h1>
        <p class="text-sm text-muted-foreground">
            Vue globale de toutes les données LifeOps
        </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Utilisateurs -->
        <a href="{{ path('app_admin_users') }}" class="col-span-full">
            <div class="border-border bg-card transition-colors hover:bg-secondary/50 rounded-lg border shadow-sm">
                <div class="p-5">
                    <div class="flex items-start justify-between">
                        <div class="flex flex-col gap-1">
                            <p class="text-sm text-muted-foreground">Utilisateurs</p>
                            <p class="text-3xl font-bold text-card-foreground">{{ total_users }}</p>
                            <p class="text-xs text-muted-foreground">{{ admin_users }} admin</p>
                        </div>
                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[hsl(199,89%,48%)]/15 text-[hsl(199,89%,48%)]">
                            <i data-lucide="users" class="h-5 w-5"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="border-border bg-card rounded-lg border shadow-sm p-6">
             <h3 class="font-semibold leading-none tracking-tight flex items-center gap-2 text-base text-card-foreground mb-4">
                <i data-lucide="clock" class="h-4 w-4 text-primary"></i>
                Gestion du Temps
            </h3>
            <p class="text-sm text-muted-foreground mb-4">Accéder à la gestion globale des plannings et activités.</p>
            <a href="{{ path('app_admin_temps') }}" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
                Aller au module Temps
            </a>
        </div>
    </div>
</div>
{% endblock %}
