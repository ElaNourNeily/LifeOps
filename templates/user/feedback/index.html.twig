{% extends 'base.html.twig' %}

{% block title %}Mes Feedbacks - LifeOps{% endblock %}

{% block body %}
<div class="space-y-8">
    {# Header Section #}
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-card/50 backdrop-blur-xl border border-border p-8 rounded-2xl shadow-xl">
        <div>
            <h1 class="text-3xl font-bold tracking-tight text-foreground flex items-center gap-3">
                <span>💬</span> Feedbacks de la communauté
            </h1>
            <p class="text-muted-foreground mt-2">Découvrez ce que les autres utilisateurs pensent de LifeOps.</p>
        </div>
        <a href="{{ path('app_feedback_new') }}" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-6 rounded-xl transition-all shadow-lg shadow-primary/20">
            <span>✨</span> Nouveau Feedback
        </a>
    </div>

    {# Feedbacks List #}
    <div class="grid gap-6">
        {% for feedback in feedbacks %}
            <div class="group bg-card/50 backdrop-blur-xl border border-border rounded-2xl p-6 hover:border-primary/50 transition-all shadow-md hover:shadow-primary/5">
                <div class="flex flex-col md:flex-row justify-between gap-4">
                    <div class="space-y-3 flex-1">
                        <div class="flex items-center gap-3">
                            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider 
                                {% if feedback.typeFeedback == 'bug' %}bg-destructive/10 text-destructive border border-destructive/20
                                {% elseif feedback.typeFeedback == 'suggestion' %}bg-primary/10 text-primary border border-primary/20
                                {% else %}bg-secondary text-muted-foreground border border-border{% endif %}">
                                {{ feedback.typeFeedback|capitalize }}
                            </span>
                            <span class="text-sm font-semibold text-primary">
                                {{ feedback.utilisateur.prenom }} {{ feedback.utilisateur.nom|first }}.
                            </span>
                            <span class="text-xs text-muted-foreground">•</span>
                            <span class="text-sm text-muted-foreground">
                                {{ feedback.date|date('d/m/Y H:i') }}
                            </span>
                            <div class="flex items-center gap-1 text-yellow-500">
                                {% for i in 1..5 %}
                                    <span class="text-lg">{{ i <= feedback.note ? '⭐' : '☆' }}</span>
                                {% endfor %}
                            </div>
                        </div>
                        
                        <div class="bg-background/50 rounded-xl p-4 border border-border/50">
                            <p class="text-foreground leading-relaxed whitespace-pre-wrap">{{ feedback.message }}</p>
                        </div>
                    </div>

                    <div class="flex md:flex-col items-center justify-between md:justify-center md:items-end gap-3 min-w-[120px]">
                        <div class="text-right">
                            <span class="text-xs text-muted-foreground block mb-1 uppercase tracking-tighter font-bold">Module</span>
                            <span class="text-sm font-medium bg-secondary px-3 py-1 rounded-lg border border-border">
                                {{ feedback.moduleCible|capitalize }}
                            </span>
                        </div>
                        <div class="text-right">
                            <span class="text-xs text-muted-foreground block mb-1 uppercase tracking-tighter font-bold">Statut</span>
                            <span class="px-3 py-1 rounded-full text-xs font-bold 
                                {% if feedback.statut == 'nouveau' %}bg-blue-500/10 text-blue-400 border border-blue-500/20
                                {% elseif feedback.statut == 'traité' %}bg-green-500/10 text-green-400 border border-green-500/20
                                {% else %}bg-secondary text-muted-foreground{% endif %}">
                                {{ feedback.statut|capitalize }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="flex flex-col items-center justify-center py-20 bg-card/30 backdrop-blur-sm border border-dashed border-border rounded-3xl text-center">
                <div class="w-20 h-20 rounded-full bg-secondary/50 flex items-center justify-center text-4xl mb-6">
                    📭
                </div>
                <h3 class="text-xl font-bold text-foreground mb-2">Aucun feedback trouvé</h3>
                <p class="text-muted-foreground max-w-xs mx-auto mb-8">
                    Vous n'avez pas encore envoyé de retours. Votre avis est précieux pour nous !
                </p>
                <a href="{{ path('app_feedback_new') }}" class="bg-primary hover:bg-primary/90 text-primary-foreground font-semibold py-3 px-8 rounded-xl transition-all shadow-lg">
                    Envoyer mon premier feedback
                </a>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .text-yellow-500 {
        filter: drop-shadow(0 0 5px rgba(234, 179, 8, 0.3));
    }
</style>
{% endblock %}
