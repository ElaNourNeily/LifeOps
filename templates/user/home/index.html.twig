<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LifeOps - Assistant Intelligent de Vie</title>
  <meta name="description" content="Centralisez votre gestion personnelle intelligente : sante, finances, temps, taches, objectifs et habitudes." />
  <meta name="theme-color" content="#0a0c10" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ========== RESET & BASE ========== */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #0a0c10;
      --fg: #eaeaf0;
      --card: #111318;
      --border: #1e2028;
      --muted: #71717a;
      --primary: #3d1d66;
      --primary-light: #5a2d8a;
      --primary-fg: #ffffff;
      --success: #10b981;
      --warning: #f59e0b;
      --info: #0ea5e9;
      --pink: #e8447a;
      --purple: #a855f7;
      --radius: 12px;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--fg);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: #2a2a35; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #3a3a45; }

    /* ========== NAVBAR ========== */
    .navbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      border-bottom: 1px solid rgba(30,32,40,0.5);
      background: rgba(10,12,16,0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .navbar-inner {
      max-width: 1152px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 24px;
    }
    .navbar-logo {
      display: flex; align-items: center; gap: 10px;
    }
    .navbar-logo img { width: 36px; height: 36px; border-radius: 6px; }
    .navbar-logo span { font-size: 20px; font-weight: 700; letter-spacing: -0.5px; }

    .navbar-links {
      display: flex; align-items: center; gap: 32px;
    }
    .navbar-links a {
      font-size: 14px; font-weight: 500; color: var(--muted);
      transition: color 0.2s;
    }
    .navbar-links a:hover { color: var(--fg); }

    .navbar-actions {
      display: flex; align-items: center; gap: 12px;
    }
    .btn-outline {
      padding: 10px 20px; font-size: 14px; font-weight: 500;
      border: 1px solid var(--border); border-radius: 8px;
      background: transparent; color: var(--fg); cursor: pointer;
      transition: background 0.2s;
    }
    .btn-outline:hover { background: rgba(255,255,255,0.05); }
    .btn-primary {
      padding: 10px 20px; font-size: 14px; font-weight: 600;
      border: none; border-radius: 8px;
      background: var(--primary); color: var(--primary-fg); cursor: pointer;
      transition: background 0.2s;
    }
    .btn-primary:hover { background: var(--primary-light); }

    .btn-primary-lg {
      padding: 14px 32px; font-size: 16px; font-weight: 600;
      border: none; border-radius: 8px;
      background: var(--primary); color: var(--primary-fg); cursor: pointer;
      transition: background 0.2s;
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-primary-lg:hover { background: var(--primary-light); }
    .btn-primary-lg svg { transition: transform 0.2s; }
    .btn-primary-lg:hover svg { transform: translateX(2px); }

    .btn-outline-lg {
      padding: 14px 32px; font-size: 16px; font-weight: 600;
      border: 1px solid var(--border); border-radius: 8px;
      background: var(--card); color: var(--fg); cursor: pointer;
      transition: background 0.2s;
    }
    .btn-outline-lg:hover { background: rgba(255,255,255,0.05); }

    /* Mobile menu */
    .hamburger {
      display: none; background: none; border: none; color: var(--fg);
      cursor: pointer; width: 40px; height: 40px;
      align-items: center; justify-content: center;
    }
    .mobile-menu {
      display: none; flex-direction: column; gap: 16px;
      padding: 16px 24px 24px; border-top: 1px solid rgba(30,32,40,0.5);
      background: var(--bg);
    }
    .mobile-menu a { font-size: 14px; font-weight: 500; color: var(--muted); }
    .mobile-menu a:hover { color: var(--fg); }
    .mobile-menu.open { display: flex; }

    @media (max-width: 768px) {
      .navbar-links, .navbar-actions { display: none; }
      .hamburger { display: flex; }
    }

    /* ========== HERO ========== */
    .hero {
      position: relative; min-height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 80px 24px 48px; text-align: center;
    }
    .hero-glow {
      position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: 800px; height: 600px; border-radius: 50%;
      background: rgba(61,29,102,0.06); filter: blur(80px);
      pointer-events: none;
    }
    .hero-content { position: relative; z-index: 1; max-width: 800px; margin: 0 auto; }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 16px; border-radius: 999px;
      border: 1px solid var(--border); background: var(--card);
      font-size: 14px; font-weight: 500; color: var(--muted);
      margin-bottom: 32px;
    }
    .hero-badge-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--primary);
    }

    .hero h1 {
      font-size: clamp(36px, 6vw, 72px); font-weight: 700;
      line-height: 1.1; letter-spacing: -1.5px;
      text-wrap: balance;
    }
    .hero h1 .highlight { color: var(--primary-light); }

    .hero-sub {
      margin-top: 24px; font-size: 18px; line-height: 1.6;
      color: var(--muted); max-width: 640px; margin-left: auto; margin-right: auto;
    }

    .hero-cta {
      margin-top: 40px; display: flex; flex-wrap: wrap;
      align-items: center; justify-content: center; gap: 16px;
    }

    .hero-stats {
      margin-top: 80px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px;
    }
    .hero-stats .stat-value { font-size: clamp(24px, 3vw, 32px); font-weight: 700; }
    .hero-stats .stat-label { margin-top: 4px; font-size: 14px; color: var(--muted); }

    @media (max-width: 640px) {
      .hero-stats { grid-template-columns: repeat(2, 1fr); }
    }

    /* ========== SECTIONS SHARED ========== */
    .section { padding: 96px 24px; }
    .section-inner { max-width: 1152px; margin: 0 auto; }
    .section-header { max-width: 640px; margin: 0 auto; text-align: center; }
    .section-tag {
      font-size: 14px; font-weight: 600; text-transform: uppercase;
      letter-spacing: 2px; color: var(--primary-light);
    }
    .section-title {
      margin-top: 12px; font-size: clamp(28px, 4vw, 40px); font-weight: 700;
      letter-spacing: -0.5px; text-wrap: balance;
    }
    .section-desc {
      margin-top: 16px; font-size: 18px; line-height: 1.6; color: var(--muted);
    }

    /* ========== FEATURES ========== */
    .features-grid {
      margin-top: 64px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
    }
    .feature-card {
      padding: 24px; border-radius: var(--radius);
      border: 1px solid var(--border); background: var(--card);
      transition: border-color 0.2s, background 0.2s;
    }
    .feature-card:hover { border-color: rgba(61,29,102,0.3); }
    .feature-icon {
      width: 48px; height: 48px; border-radius: 8px; margin-bottom: 16px;
      display: flex; align-items: center; justify-content: center;
      background: rgba(61,29,102,0.12);
    }
    .feature-icon svg { width: 24px; height: 24px; color: var(--primary-light); }
    .feature-card h3 { font-size: 18px; font-weight: 600; }
    .feature-card p { margin-top: 8px; font-size: 14px; line-height: 1.6; color: var(--muted); }

    @media (max-width: 1024px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .features-grid { grid-template-columns: 1fr; } }

    /* ========== MODULES ========== */
    .modules-grid {
      margin-top: 64px;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
    }
    .module-card {
      position: relative; overflow: hidden; padding: 24px;
      border-radius: var(--radius); border: 1px solid var(--border);
      background: var(--card); transition: border-color 0.2s;
    }
    .module-card:hover { border-color: rgba(255,255,255,0.08); }
    .module-bar {
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
      transition: height 0.2s;
    }
    .module-card:hover .module-bar { height: 6px; }
    .module-body { display: flex; gap: 16px; }
    .module-icon {
      width: 44px; height: 44px; border-radius: 8px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .module-icon svg { width: 20px; height: 20px; }
    .module-content { flex: 1; }
    .module-content h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
    .module-tag {
      display: inline-block; padding: 2px 10px; border-radius: 999px;
      font-size: 12px; font-weight: 500; margin-bottom: 12px;
    }
    .module-content p { font-size: 14px; line-height: 1.6; color: var(--muted); }

    @media (max-width: 1024px) { .modules-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .modules-grid { grid-template-columns: 1fr; } }

    /* ========== STATS ========== */
    .stats-box {
      border-radius: 16px; border: 1px solid var(--border);
      background: var(--card); overflow: hidden;
      display: grid; grid-template-columns: repeat(3, 1fr);
    }
    .stats-box > div { padding: 40px; }
    .stats-box > div + div { border-left: 1px solid var(--border); }
    .stat-icon {
      width: 40px; height: 40px; border-radius: 8px; margin-bottom: 16px;
      display: flex; align-items: center; justify-content: center;
    }
    .stat-icon svg { width: 20px; height: 20px; }
    .stat-number { font-size: clamp(28px, 3vw, 36px); font-weight: 700; }
    .stat-name { margin-top: 4px; font-size: 14px; font-weight: 500; color: var(--muted); }
    .stat-desc { margin-top: 12px; font-size: 14px; line-height: 1.6; color: var(--muted); }

    @media (max-width: 768px) {
      .stats-box { grid-template-columns: 1fr; }
      .stats-box > div + div { border-left: none; border-top: 1px solid var(--border); }
    }

    /* ========== CTA ========== */
    .cta-box {
      position: relative; overflow: hidden; border-radius: 16px;
      border: 1px solid rgba(61,29,102,0.25);
      background: rgba(61,29,102,0.06);
      padding: 64px 24px; text-align: center;
    }
    .cta-glow-l, .cta-glow-r {
      position: absolute; width: 288px; height: 288px; border-radius: 50%;
      background: rgba(61,29,102,0.12); filter: blur(80px); pointer-events: none;
    }
    .cta-glow-l { top: -80px; left: -80px; }
    .cta-glow-r { bottom: -80px; right: -80px; }
    .cta-box h2 {
      font-size: clamp(28px, 4vw, 48px); font-weight: 700;
      letter-spacing: -0.5px; text-wrap: balance;
    }
    .cta-box p {
      margin-top: 16px; font-size: 18px; line-height: 1.6;
      color: var(--muted); max-width: 560px; margin-left: auto; margin-right: auto;
    }
    .cta-actions { margin-top: 40px; position: relative; z-index: 1; }

    /* ========== FOOTER ========== */
    .footer {
      border-top: 1px solid var(--border); padding: 48px 24px;
    }
    .footer-inner {
      max-width: 1152px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 24px;
    }
    .footer-logo { display: flex; align-items: center; gap: 10px; }
    .footer-logo img { width: 32px; height: 32px; border-radius: 6px; }
    .footer-logo span { font-size: 18px; font-weight: 700; }
    .footer-links { display: flex; align-items: center; gap: 24px; }
    .footer-links a { font-size: 14px; color: var(--muted); transition: color 0.2s; }
    .footer-links a:hover { color: var(--fg); }
    .footer-copy { font-size: 14px; color: var(--muted); }

    @media (max-width: 768px) {
      .footer-inner { flex-direction: column; text-align: center; }
    }

    /* ========== ARROW ICON ========== */
    .arrow-icon { width: 16px; height: 16px; }
  </style>
</head>
<body>

  <!-- ===== NAVBAR ===== -->
  <header class="navbar">
    <nav class="navbar-inner">
      <a href="#" class="navbar-logo">
        <img src="{{ asset('logo.jpeg') }}" alt="LifeOps Logo" style="width: 40px; height: 40px; object-fit: contain;" />
